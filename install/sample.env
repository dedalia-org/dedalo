# ══════════════════════════════════════════════════════════════════════════════
#  DÉDALO v7 — sample.env  ·  every configurable setting, grouped by domain
# ══════════════════════════════════════════════════════════════════════════════
#
# Reference of every configuration setting this engine recognizes. This file
# is NOT loaded by Dédalo — copy the lines you need into ../private/.env and
# uncomment them. The installer drops a copy of this file next to your .env.
#
# FORMAT. KEY=value, one per line. No ${VAR} interpolation. Quote any value
# containing spaces or a #. List and map values are JSON — ["lg-eng","lg-spa"]
# or {"lg-eng":"English"}; simple lists also accept a comma list. Booleans are
# true/false.
#
# PRECEDENCE (low→high): catalog default → ../private/.env → the real process
# environment. There is no per-host overlay. After changing a value, restart
# the server.
#
# TAGS. [operator] a setting you may freely change · [secret] sensitive — set
# a real value, never commit it. Every line below is COMMENTED OUT at its
# default; uncomment only what you need to change. Lines that ship UNCOMMENTED
# carry a placeholder a real install must replace.
#
# EACH ENTRY. A short description, then [scope · type] default: …, then an
# "example:" showing a real value for that exact key — copy the example line,
# uncomment it and edit the value. The full prose, tables and rationale for
# every setting live in docs/config/config.md and docs/config/config_db.md.
#
#  GENERATED from src/config/catalog/ — do not edit by hand.
#  Regenerate: bun run config:gen   (config_docs_tripwire fails if you forget)
# ══════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════
#  [paths]  Main variables: Paths
# ══════════════════════════════════════════════════════════════════════════════

# The public domain or IP of this installation — the address other machines
# use to reach it. Dédalo does not need it to serve you; it needs it to tell
# someone else where it lives.
# [operator · string]  default: (empty)
# example:
#   DEDALO_HOST="dedalo.example.org"
#DEDALO_HOST=

# This parameter defines the internet protocol used to build absolute URLs. It
# is recommended to use the HTTPS protocol for an installation with SSL
# certification — it is not mandatory, but it ensures the connection is
# protected with encryption. Defaults to "http://" when unset.
# [operator · string]  default: http://
# example:
#   DEDALO_PROTOCOL="https://"
#DEDALO_PROTOCOL=http://

# ══════════════════════════════════════════════════════════════════════════════
#  [locale]  Locale
# ══════════════════════════════════════════════════════════════════════════════

# Defines the default order for the date input by users and to be showed in
# component_date. By default Dédalo use dmy (European dates format).
# [operator · string]  default: dmy
# example:
#   DEDALO_DATE_ORDER="dmy"
#DEDALO_DATE_ORDER=dmy

# Defines the UI locale used to format and encode text. By default Dédalo uses
# UTF-8 encoding for Spanish (es-ES).
# [operator · string]  default: es-ES
# example:
#   DEDALO_LOCALE="es-ES"
#DEDALO_LOCALE=es-ES

# Used to defines the time zone of the project. It could be different of the
# server installation or the linux timezone. The time zone will be used to
# store the time stamp of the changes done by the users.
# [operator · string]  default: Europe/Madrid
# example:
#   DEDALO_TIMEZONE="Europe/Madrid"
#DEDALO_TIMEZONE=Europe/Madrid

# ══════════════════════════════════════════════════════════════════════════════
#  [entity]  Entity
# ══════════════════════════════════════════════════════════════════════════════

# This parameter defines the normalized id for the entity. The id of the
# entity could be used to create a locator to obtain information between
# Dédalo installations, the id will be added to the locator with the key:
# "entity_id" when the locator point to external resource.
# [operator · int]  default: 0
# example:
#   DEDALO_ENTITY_ID=0
#DEDALO_ENTITY_ID=0

# Defines the entity label, the real name of the entity. Due the entity
# definition is use to encrypt passwords or access to databases, sometimes you
# will need define the real name of the entity with characters such as 'ñ' or
# accents.
# [operator · string]  default: the value of `ENTITY`
# example:
#   DEDALO_ENTITY_LABEL="Museu de Prehistòria de València"
DEDALO_ENTITY_LABEL=Dédalo install version

# This parameter defines the name of the entity proprietary of the Dédalo
# installation. Dédalo entity will be used to access to databases, to encrypt
# passwords or to publish data into the specific publication ontology and
# should NOT be changed after installation.
# [operator · string]  default: install
# example:
#   ENTITY="my_entity_name"
ENTITY=my_entity_name

# ══════════════════════════════════════════════════════════════════════════════
#  [langs]  Languages
# ══════════════════════════════════════════════════════════════════════════════

# This parameter defines the language will us Dédalo for the user interface.
# [operator · string]  default: lg-spa
# example:
#   APPLICATION_LANG="lg-spa"
#APPLICATION_LANG=lg-spa

# It defines the data language used by Dédalo to process and render textual
# information.
# [operator · string]  default: lg-spa
# example:
#   DATA_LANG="lg-spa"
#DATA_LANG=lg-spa

# Defines whether the application language and data language selection remain
# synchronized.
# [operator · bool]  default: false
# example:
#   DATA_LANG_SYNC=false
#DATA_LANG_SYNC=false

# This parameter defines the tld used by Dédalo to tag data without
# translation possibility.
# [operator · string]  default: lg-nolan
# example:
#   DATA_NOLAN="lg-nolan"
#DATA_NOLAN=lg-nolan

# This parameter defines the languages that Dédalo will use for the data and
# user interface. Dédalo is a true multi-language application, any text field
# can be defined as translatable and this configuration define the languages
# that the installation will use to store and translate text data. When the
# user select one of those languages Dédalo will change the data showed or the
# user interface, so it will render all data with this new language.
# [operator · object]  default: **required, no default** — the installer writes it (working languages: default `lg-eng`, `lg-spa`; interface and data default: the first one picked); the value shown in sample.env is the install-mode stand-in, never a fallback
# example:
#   DEDALO_APPLICATION_LANGS={"lg-spa":"Castellano","lg-cat":"Català","lg-eus":"Euskara","lg-eng":"English","lg-fra":"French"}
DEDALO_APPLICATION_LANGS={"lg-eng":"English","lg-spa":"Castellano"}

# Defines the main language will used in the user interface.
# [operator · string]  default: **required, no default** — the installer writes it (working languages: default `lg-eng`, `lg-spa`; interface and data default: the first one picked); the value shown in sample.env is the install-mode stand-in, never a fallback
# example:
#   DEDALO_APPLICATION_LANGS_DEFAULT="lg-eng"
DEDALO_APPLICATION_LANGS_DEFAULT=lg-eng

# Defines the main language will used by Dédalo to manage and process data.
# [operator · string]  default: **required, no default** — the installer writes it (working languages: default `lg-eng`, `lg-spa`; interface and data default: the first one picked); the value shown in sample.env is the install-mode stand-in, never a fallback
# example:
#   DEDALO_DATA_LANG_DEFAULT="lg-spa"
DEDALO_DATA_LANG_DEFAULT=lg-eng

# Groups of language codes that are the same language under different names.
# The shipped default declares Català and Valencià as one language, matching
# how earlier Dédalo versions treated them.
# [operator · json]  default: [["lg-cat","lg-vlca"]]
# example:
#   DEDALO_LANG_EQUIVALENCES='[["lg-cat","lg-vlca"]]'
#DEDALO_LANG_EQUIVALENCES=[["lg-cat","lg-vlca"]]

# It defines if the menu show or hide the data language selector.
# [operator · bool]  default: true
# example:
#   DEDALO_DATA_LANG_SELECTOR=true
#DEDALO_DATA_LANG_SELECTOR=true

# This parameter defines the languages that Dédalo will use to publish data.
# [operator · array]  default: the project languages (DEDALO_PROJECTS_DEFAULT_LANGS)
# example:
#   DEDALO_DIFFUSION_LANGS=["lg-spa","lg-cat","lg-eng"]
#DEDALO_DIFFUSION_LANGS=

# This parameter defines the ontology LABEL FALLBACK language. Every ontology
# label (the name of an area, section, field or tool shown in the interface)
# can be translated to any language; when the interface language has no
# translation for a label, Dédalo shows it in this language, and when this
# language is missing too, in any other language available.
# [operator · string]  default: lg-spa
# example:
#   DEDALO_STRUCTURE_LANG="lg-spa"
#DEDALO_STRUCTURE_LANG=lg-spa

# This parameter defines the languages that will use for export and publish
# data.
# [operator · array]  default: **required, no default** — the installer writes it (working languages: default `lg-eng`, `lg-spa`; interface and data default: the first one picked); the value shown in sample.env is the install-mode stand-in, never a fallback
# example:
#   PROJECTS_DEFAULT_LANGS=[ "lg-spa", "lg-cat", "lg-eng"]
PROJECTS_DEFAULT_LANGS=["lg-eng","lg-spa"]

# ══════════════════════════════════════════════════════════════════════════════
#  [defaults]  Default variables
# ══════════════════════════════════════════════════════════════════════════════

# This parameter defines the ontology TLDs to be used in the Dédalo
# installation.
# [operator · array]  default: ["dd","rsc","ontology","ontologytype","hierarchy","lg"]
# example:
#   ACTIVE_ONTOLOGY_TLDS=[ "dd", "rsc", "ontology", "ontologytype", "hierarchy", "lg", "oh", "ich" ]
#ACTIVE_ONTOLOGY_TLDS=["dd","rsc","ontology","ontologytype","hierarchy","lg"]

# This parameter defines the default project that Dédalo will use to create
# new sections (records in the DDBB).
# [operator · int]  default: 1
# example:
#   DEDALO_DEFAULT_PROJECT=1
#DEDALO_DEFAULT_PROJECT=1

# This parameter defines the section that has the projects information inside
# the ontology.
# [operator · string]  default: dd153
# example:
#   DEDALO_FILTER_SECTION_TIPO_DEFAULT="dd153"
#DEDALO_FILTER_SECTION_TIPO_DEFAULT=dd153

# It defines the maximum rows that will loaded in the lists.
# [operator · int]  default: 10
# example:
#   DEDALO_MAX_ROWS_PER_PAGE=10
#DEDALO_MAX_ROWS_PER_PAGE=10

# This parameter defines the ceiling applied to the number of rows a search
# coming FROM THE CLIENT may ask for.
# [operator · int]  default: 1000
# example:
#   DEDALO_SEARCH_CLIENT_MAX_LIMIT=1000
#DEDALO_SEARCH_CLIENT_MAX_LIMIT=1000

# This parameter defines the section of the ontology that holds the USER
# records — the login names, the password hashes, the profile and the projects
# each user may reach.
# [operator · string]  default: dd128
# example:
#   DEDALO_SECTION_USERS_TIPO="dd128"
#DEDALO_SECTION_USERS_TIPO=dd128

# It defines the section that is loaded by default when the user logs in. The
# main section of the project, normally an inventory or catalog section.
# [operator · string]  default: (empty)
# example:
#   MAIN_SECTION="oh1"
#MAIN_SECTION=

# ══════════════════════════════════════════════════════════════════════════════
#  [media]  Media variables
# ══════════════════════════════════════════════════════════════════════════════

# This engine builds no alternative versions of 3d files, so this parameter
# has no effect. Keep it empty.
# [operator · array]  default: []
# example:
#   DEDALO_3D_ALTERNATIVE_EXTENSIONS=[]
#DEDALO_3D_ALTERNATIVE_EXTENSIONS=[]

# This parameter defines the different qualities that can be used for store 3d
# files.
# [operator · array]  default: ["original","web"]
# example:
#   DEDALO_3D_AR_QUALITY=["original","web"]
#DEDALO_3D_AR_QUALITY=["original","web"]

# This parameter defines the standard file type of 3d files.
# [operator · string]  default: glb
# example:
#   DEDALO_3D_EXTENSION="glb"
#DEDALO_3D_EXTENSION=glb

# This parameter defines the standards file type admitted for the 3d files.
# [operator · array]  default: ["glb","gltf","obj","fbx","dae","zip"]
# example:
#   DEDALO_3D_EXTENSIONS_SUPPORTED=["glb"]
#DEDALO_3D_EXTENSIONS_SUPPORTED=["glb","gltf","obj","fbx","dae","zip"]

# This parameter define the main directory for the 3d files.
# [operator · string]  default: /3d
# example:
#   DEDALO_3D_FOLDER="/3d"
#DEDALO_3D_FOLDER=/3d

# This parameter defines the default quality used for the 3d files.
# [operator · string]  default: web
# example:
#   DEDALO_3D_QUALITY_DEFAULT="web"
#DEDALO_3D_QUALITY_DEFAULT=web

# This parameter defines the quality original for the 3d files.
# [operator · string]  default: original
# example:
#   DEDALO_3D_QUALITY_ORIGINAL="original"
#DEDALO_3D_QUALITY_ORIGINAL=original

# This engine builds no alternative versions of audiovisual files, so this
# parameter has no effect. Keep it empty.
# [operator · array]  default: []
# example:
#   DEDALO_AV_ALTERNATIVE_EXTENSIONS=[]
#DEDALO_AV_ALTERNATIVE_EXTENSIONS=[]

# This parameter defines the different qualities that can be used for compress
# the audiovisual files.
# [operator · array]  default: ["original","1080","720","576","404","240","audio"]
# example:
#   DEDALO_AV_AR_QUALITY=["original","1080","720","576","404","240","audio"]
#DEDALO_AV_AR_QUALITY=["original","1080","720","576","404","240","audio"]

# This parameter defines the standard file type of encapsulation for the
# audiovisual files.
# [operator · string]  default: mp4
# example:
#   DEDALO_AV_EXTENSION="mp4"
#DEDALO_AV_EXTENSION=mp4

# This parameter defines the standards file type admitted for the audiovisual
# files.
# [operator · array]  default: ["mp4","wave","wav","aiff","aif","mp3","mov","avi","mpg","mpeg","vob","zip","flv"]
# example:
#   DEDALO_AV_EXTENSIONS_SUPPORTED=["mp4","wave","wav","aiff","aif","mp3","mov","avi","mpg","mpeg","vob","zip","flv"]
#DEDALO_AV_EXTENSIONS_SUPPORTED=["mp4","wave","wav","aiff","aif","mp3","mov","avi","mpg","mpeg","vob","zip","flv"]

# This parameter defines the path to the qt-faststart library in the server.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/qt-faststart`
# example:
#   DEDALO_AV_FASTSTART_PATH="/usr/bin/qt-faststart"
#DEDALO_AV_FASTSTART_PATH=

# This parameter defines the path to the ffmpeg library in the server. ffmpeg
# will use to compress the audiovisual files.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/ffmpeg`
# example:
#   DEDALO_AV_FFMPEG_PATH="/usr/bin/ffmpeg"
#DEDALO_AV_FFMPEG_PATH=

# This parameter defines the path to the ffprobe library in the server.
# ffprobe is used to analyze the audiovisual files and get his metadata.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/ffprobe`
# example:
#   DEDALO_AV_FFPROBE_PATH="/usr/bin/ffprobe"
#DEDALO_AV_FFPROBE_PATH=

# This parameter defines the main directory for the audiovisual files.
# [operator · string]  default: /av
# example:
#   DEDALO_AV_FOLDER="/av"
#DEDALO_AV_FOLDER=/av

# This parameter defines the type of the image file used to create the
# posterframe of the audiovisual files.
# [operator · string]  default: jpg
# example:
#   DEDALO_AV_POSTERFRAME_EXTENSION="jpg"
#DEDALO_AV_POSTERFRAME_EXTENSION=jpg

# This parameter defines the default quality used for the audiovisual files.
# [operator · string]  default: 404
# example:
#   DEDALO_AV_QUALITY_DEFAULT="404"
#DEDALO_AV_QUALITY_DEFAULT=404

# This parameter defines the quality original for the audiovisual files.
# [operator · string]  default: original
# example:
#   DEDALO_AV_QUALITY_ORIGINAL="original"
#DEDALO_AV_QUALITY_ORIGINAL=original

# This parameter defines the standard used to create the subtitles.
# [operator · string]  default: vtt
# example:
#   DEDALO_AV_SUBTITLES_EXTENSION="vtt"
#DEDALO_AV_SUBTITLES_EXTENSION=vtt

# This parameter defines the directory where the external media binaries are
# installed.
# [operator · string]  default: `/opt/homebrew/bin` on macOS, `/usr/bin` elsewhere
# example:
#   DEDALO_BINARY_BASE="/usr/local/bin"
#DEDALO_BINARY_BASE=

# This parameter defines the path to the file utility in the server, the
# program that reports the type of a file from its content.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/file`
# example:
#   DEDALO_FILE_BIN_PATH="/usr/bin/file"
#DEDALO_FILE_BIN_PATH=

# Latitude the geolocation map OPENS on when the record has no coordinate
# stored.
# [operator · float]  default: 20
# example:
#   DEDALO_GEO_DEFAULT_LAT="20"
#DEDALO_GEO_DEFAULT_LAT=20

# Longitude the geolocation map OPENS on when the record has no coordinate
# stored.
# [operator · float]  default: 0
# example:
#   DEDALO_GEO_DEFAULT_LON="0"
#DEDALO_GEO_DEFAULT_LON=0

# Zoom level the geolocation map OPENS on when the record has no coordinate
# stored.
# [operator · int]  default: 2
# example:
#   DEDALO_GEO_DEFAULT_ZOOM="2"
#DEDALO_GEO_DEFAULT_ZOOM=2

# This parameter defines the tile maps provider to be used.
# [operator · string]  default: VARIOUS
# example:
#   DEDALO_GEO_PROVIDER="VARIOUS"
#DEDALO_GEO_PROVIDER=VARIOUS

# This parameter names the directory, inside the media directory, that holds
# self-contained HTML copies generated from records — the single files an
# institution hands to a visitor or publishes beside a catalogue.
# [operator · string]  default: /html_files
# example:
#   DEDALO_HTML_FILES_FOLDER="/html_files"
#DEDALO_HTML_FILES_FOLDER=/html_files

# This parameter defines the path to the ImageMagick identify program in the
# server. Dédalo uses it to read the attributes of an image file — dimensions,
# format, colorspace, orientation, transparency — before deciding how to
# compress it.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/identify`
# example:
#   DEDALO_IDENTIFY_PATH="/usr/bin/identify"
#DEDALO_IDENTIFY_PATH=

# This parameter defines the path to the rsvg-convert program in the server,
# shipped with librsvg. Dédalo uses it — and only it — to turn a vector SVG
# into a raster image, which is how the thumbnail of an SVG record is
# produced.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/rsvg-convert`
# example:
#   DEDALO_RSVG_CONVERT_PATH="/usr/bin/rsvg-convert"
#DEDALO_RSVG_CONVERT_PATH=

# This parameter defines the resolution, in dots per inch, at which an SVG is
# rendered before it is reduced to a thumbnail. A vector file has no pixels of
# its own, so a resolution has to be chosen for it; 150 dpi is enough for a
# crisp thumbnail without rendering a needlessly large intermediate image.
# [operator · int]  default: 150
# example:
#   DEDALO_SVG_THUMB_DPI=150
#DEDALO_SVG_THUMB_DPI=150

# This parameter defines how much memory one ImageMagick process may use for
# its pixel cache before it starts spilling to disk.
# [operator · string]  default: 2GiB
# example:
#   DEDALO_MAGICK_LIMIT_MEMORY="2GiB"
#DEDALO_MAGICK_LIMIT_MEMORY=2GiB

# This parameter defines how much memory-mapped address space one ImageMagick
# process may use for its pixel cache before it falls back to the disk-backed
# cache.
# [operator · string]  default: 4GiB
# example:
#   DEDALO_MAGICK_LIMIT_MAP="4GiB"
#DEDALO_MAGICK_LIMIT_MAP=4GiB

# This parameter defines the pixel area above which ImageMagick caches an
# image on disk instead of in memory.
# [operator · string]  default: 2GiB
# example:
#   DEDALO_MAGICK_LIMIT_AREA="2GiB"
#DEDALO_MAGICK_LIMIT_AREA=2GiB

# This parameter defines how much disk one ImageMagick process may use for its
# pixel cache.
# [operator · string]  default: 16GiB
# example:
#   DEDALO_MAGICK_LIMIT_DISK="16GiB"
#DEDALO_MAGICK_LIMIT_DISK=16GiB

# This parameter defines the largest image WIDTH, in pixels, that ImageMagick
# will read.
# [operator · int]  default: 100000
# example:
#   DEDALO_MAGICK_LIMIT_WIDTH=100000
#DEDALO_MAGICK_LIMIT_WIDTH=100000

# This parameter defines the largest image HEIGHT, in pixels, that ImageMagick
# will read. It is the counterpart of DEDALO_MAGICK_LIMIT_WIDTH and everything
# said there applies to it unchanged, including the 200000 ceiling in the
# shipped policy.
# [operator · int]  default: 100000
# example:
#   DEDALO_MAGICK_LIMIT_HEIGHT=100000
#DEDALO_MAGICK_LIMIT_HEIGHT=100000

# This parameter defines how many IMAGES one file may contain before
# ImageMagick refuses to read it.
# [operator · int]  default: 4096
# example:
#   DEDALO_MAGICK_LIMIT_LIST_LENGTH=4096
#DEDALO_MAGICK_LIMIT_LIST_LENGTH=4096

# This parameter defines how long, in seconds, one ImageMagick process may run
# before it is refused.
# [operator · int]  default: 900
# example:
#   DEDALO_MAGICK_LIMIT_TIME=900
#DEDALO_MAGICK_LIMIT_TIME=900

# This parameter defines the extra file formats Dédalo builds beside the
# standard image format defined in DEDALO_IMAGE_EXTENSION.
# [operator · array]  default: []
# example:
#   DEDALO_IMAGE_ALTERNATIVE_EXTENSIONS=["avif"]
#DEDALO_IMAGE_ALTERNATIVE_EXTENSIONS=[]

# This parameter defines the different qualities that can be used for compress
# the image files.
# [operator · serialized array]  default: ["original","modified","100MB","25MB","6MB","1.5MB","thumb"]
# example:
#   DEDALO_IMAGE_AR_QUALITY=["original","modified","100MB","25MB","6MB","1.5MB","thumb"]
#DEDALO_IMAGE_AR_QUALITY=["original","modified","100MB","25MB","6MB","1.5MB","thumb"]

# This parameter defines the standard file type of image files.
# [operator · string]  default: jpg
# example:
#   DEDALO_IMAGE_EXTENSION="jpg"
#DEDALO_IMAGE_EXTENSION=jpg

# This parameter defines the standards file type admitted for the image files.
# [operator · array]  default: ["jpg","jpeg","png","tif","tiff","bmp","psd","raw","webp","heic","avif"]
# example:
#   DEDALO_IMAGE_EXTENSIONS_SUPPORTED=["jpg","jpeg","png","tif","tiff","bmp","psd","raw","webp","heic"]
#DEDALO_IMAGE_EXTENSIONS_SUPPORTED=["jpg","jpeg","png","tif","tiff","bmp","psd","raw","webp","heic","avif"]

# This parameter defines the main directory for the image files.
# [operator · string]  default: /image
# example:
#   DEDALO_IMAGE_FOLDER="/image"
#DEDALO_IMAGE_FOLDER=/image

# This parameter defines the resolution in pixels per inch that will be used
# in the image compression to be apply when the images will be printed.
# [operator · int]  default: 150
# example:
#   DEDALO_IMAGE_PRINT_DPI=150
#DEDALO_IMAGE_PRINT_DPI=150

# This parameter defines the default quality used for the image files.
# [operator · string]  default: 1.5MB
# example:
#   DEDALO_IMAGE_QUALITY_DEFAULT="1.5MB"
#DEDALO_IMAGE_QUALITY_DEFAULT=1.5MB

# This parameter defines the quality original for the image files.
# [operator · string]  default: original
# example:
#   DEDALO_IMAGE_QUALITY_ORIGINAL="original"
#DEDALO_IMAGE_QUALITY_ORIGINAL=original

# This parameter defines the quality for the image files that has been
# retouched.
# [operator · string]  default: modified
# example:
#   DEDALO_IMAGE_QUALITY_RETOUCHED="modified"
#DEDALO_IMAGE_QUALITY_RETOUCHED=modified

# This parameter defines height size in pixels to the thumb images, it will be
# used to compress the images with the thumb quality (the smaller version to
# be used in lists).
# [operator · int]  default: 148
# example:
#   DEDALO_IMAGE_THUMB_HEIGHT=148
#DEDALO_IMAGE_THUMB_HEIGHT=148

# This parameter defines width size in pixels to the thumb images, it will be
# used to compress the images with the thumb quality (the smaller version to
# be used in lists).
# [operator · int]  default: 222
# example:
#   DEDALO_IMAGE_THUMB_WIDTH=222
#DEDALO_IMAGE_THUMB_WIDTH=222

# This parameter names the directory, inside the image directory, that holds
# browser-sized copies of pictures brought in from a rich-text field rather
# than from the image component itself.
# [operator · string]  default: /web
# example:
#   DEDALO_IMAGE_WEB_FOLDER="/web"
#DEDALO_IMAGE_WEB_FOLDER=/web

# This parameter defines the path to image magick library in the server (when
# image magick library is installed)
# [operator · string]  default: `<DEDALO_BINARY_BASE>/magick`
# example:
#   DEDALO_MAGICK_PATH="/usr/bin/"
#DEDALO_MAGICK_PATH=

# This parameter defines the NAME of the media directory as it appears in the
# URL. Every media URL Dédalo builds is /dedalo/<DEDALO_MEDIA_DIR>/ plus the
# file path.
# [operator · string]  default: media
# example:
#   DEDALO_MEDIA_DIR="media"
#DEDALO_MEDIA_DIR=media

# This parameter defines the base every media URL that LEAVES the application
# is built on — an exported list, a relation list cell, anything a third party
# opens outside Dédalo.
# [operator · string]  default: (unset)
# example:
#   DEDALO_MEDIA_EXPORT_BASE="https://my_institution.org/dedalo/media"
#DEDALO_MEDIA_EXPORT_BASE=

# This parameter defines how many image, PDF or SVG conversions Dédalo will
# run at the same time.
# [operator · int]  default: 2
# example:
#   DEDALO_MEDIA_CONVERT_CONCURRENCY=2
#DEDALO_MEDIA_CONVERT_CONCURRENCY=2

# This parameter defines how long a conversion may wait for a free conversion
# lane (DEDALO_MEDIA_CONVERT_CONCURRENCY) before it is refused.
# [operator · int (seconds)]  default: 120
# example:
#   DEDALO_MEDIA_CONVERT_QUEUE_SECONDS=120
#DEDALO_MEDIA_CONVERT_QUEUE_SECONDS=120

# This parameter defines how many audio or video conversions (ffmpeg
# processes) Dédalo will run at the same time.
# [operator · int]  default: `DEDALO_MEDIA_JOB_CONCURRENCY` + 1
# example:
#   DEDALO_MEDIA_AV_CONCURRENCY=4
#DEDALO_MEDIA_AV_CONCURRENCY=

# This parameter defines how long an audio or video conversion may wait for a
# free lane (DEDALO_MEDIA_AV_CONCURRENCY) before it is refused.
# [operator · int (seconds)]  default: 120
# example:
#   DEDALO_MEDIA_AV_QUEUE_SECONDS=120
#DEDALO_MEDIA_AV_QUEUE_SECONDS=120

# This parameter defines how many media jobs Dédalo will run at the same time.
# [operator · int]  default: 3
# example:
#   DEDALO_MEDIA_JOB_CONCURRENCY=3
#DEDALO_MEDIA_JOB_CONCURRENCY=3

# This parameter defines the directory holding the process files of the media
# jobs.
# [operator · string]  default: (unset)
# example:
#   DEDALO_MEDIA_PROCESSES_DIR="/var/lib/dedalo/processes"
#DEDALO_MEDIA_PROCESSES_DIR=

# This parameter defines the base every media URL served to the CLIENT is
# built on — the address the browser fetches images, video, PDFs and their
# derivatives from.
# [operator · string]  default: (unset)
# example:
#   DEDALO_MEDIA_WEB_BASE="http://localhost:8080/dedalo/media"
#DEDALO_MEDIA_WEB_BASE=

# This parameter defines the image formats Dédalo renders the cover of an
# uploaded PDF into.
# [operator · array]  default: ["jpg"]
# example:
#   DEDALO_PDF_ALTERNATIVE_EXTENSIONS=["jpg"]
#DEDALO_PDF_ALTERNATIVE_EXTENSIONS=["jpg"]

# This parameter defines the different qualities that can be used for compress
# the PDF files.
# [operator · array]  default: ["original","web"]
# example:
#   DEDALO_PDF_AR_QUALITY=["original","web"]
#DEDALO_PDF_AR_QUALITY=["original","web"]

# This parameter defines the standard file type of pdf files.
# [operator · string]  default: pdf
# example:
#   DEDALO_PDF_EXTENSION="pdf"
#DEDALO_PDF_EXTENSION=pdf

# This parameter define the standards file type admitted for the pdf files.
# Dédalo will use this parameter to identify the file format of the original
# files uploaded by the users. Defaults to
# ["pdf","doc","pages","odt","ods","rtf","ppt"].
# [operator · array]  default: ["pdf","doc","pages","odt","ods","rtf","ppt"]
# example:
#   DEDALO_PDF_EXTENSIONS_SUPPORTED=["pdf","doc","pages","odt","ods","rtf","ppt"]
#DEDALO_PDF_EXTENSIONS_SUPPORTED=["pdf","doc","pages","odt","ods","rtf","ppt"]

# This parameter defines the main directory for the pdf files.
# [operator · int]  default: /pdf
# example:
#   DEDALO_PDF_FOLDER="/pdf"
#DEDALO_PDF_FOLDER=/pdf

# This parameter defines the default quality used for the PDF files.
# [operator · string]  default: web
# example:
#   DEDALO_PDF_QUALITY_DEFAULT="web"
#DEDALO_PDF_QUALITY_DEFAULT=web

# This parameter defines the quality original for the pdf files.
# [operator · string]  default: original
# example:
#   DEDALO_PDF_QUALITY_ORIGINAL="original"
#DEDALO_PDF_QUALITY_ORIGINAL=original

# This parameter defines the path to the pdfinfo program in the server,
# usually shipped with Poppler. Dédalo uses it to read the metadata of the
# uploaded PDF files — the number of pages and the creation date that feeds
# the automatic date components.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/pdfinfo`
# example:
#   DEDALO_PDFINFO_PATH="/usr/bin/pdfinfo"
#DEDALO_PDFINFO_PATH=

# This parameter defines the path to the pdftohtml program in the server,
# usually shipped with Poppler. The PDF extractor tool uses it to pull the
# content of a PDF out as formatted HTML, keeping the layout of the page; the
# plain-text alternative is PDF_AUTOMATIC_TRANSCRIPTION_ENGINE, and the user
# chooses between them in the tool.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/pdftohtml`
# example:
#   DEDALO_PDFTOHTML_PATH="/usr/bin/pdftohtml"
#DEDALO_PDFTOHTML_PATH=

# This parameter defines the path to the gs program in the server, the
# Ghostscript interpreter. Dédalo uses it — and only it — to turn the first
# page of an uploaded PDF into an image, which is how the cover and the
# thumbnail of a PDF record are produced.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/gs`
# example:
#   DEDALO_GS_PATH="/usr/bin/gs"
#DEDALO_GS_PATH=

# This parameter defines the thumb quality definition that can be used for
# compress the media files.
# [operator · string]  default: thumb
# example:
#   DEDALO_QUALITY_THUMB="thumb"
#DEDALO_QUALITY_THUMB=thumb

# This parameter defines the path to the subtitles directory.
# [operator · string]  default: /subtitles
# example:
#   DEDALO_SUBTITLES_FOLDER="/subtitles"
#DEDALO_SUBTITLES_FOLDER=/subtitles

# This engine builds no alternative versions of svg files, so this parameter
# has no effect. Keep it empty.
# [operator · array]  default: []
# example:
#   DEDALO_SVG_ALTERNATIVE_EXTENSIONS=[]
#DEDALO_SVG_ALTERNATIVE_EXTENSIONS=[]

# This parameter defines the different qualities that can be used transformed
# svg files.
# [operator · array]  default: ["original","web"]
# example:
#   DEDALO_SVG_AR_QUALITY=["original","web"]
#DEDALO_SVG_AR_QUALITY=["original","web"]

# This parameter defines the standard file type of svg files.
# [operator · string]  default: svg
# example:
#   DEDALO_SVG_EXTENSION="svg"
#DEDALO_SVG_EXTENSION=svg

# This parameter defines the standards file type admitted for the svg files.
# [operator · array]  default: ["svg"]
# example:
#   DEDALO_SVG_EXTENSIONS_SUPPORTED=["svg"]
#DEDALO_SVG_EXTENSIONS_SUPPORTED=["svg"]

# This parameter defines the main directory for the svg files.
# [operator · string]  default: /svg
# example:
#   DEDALO_SVG_FOLDER="/svg"
#DEDALO_SVG_FOLDER=/svg

# This parameter defines the default quality used for the SVG files.
# [operator · string]  default: web
# example:
#   DEDALO_SVG_QUALITY_DEFAULT="web"
#DEDALO_SVG_QUALITY_DEFAULT=web

# This parameter defines the quality original for the svg files.
# [operator · string]  default: original
# example:
#   DEDALO_SVG_QUALITY_ORIGINAL="original"
#DEDALO_SVG_QUALITY_ORIGINAL=original

# This parameter defines the standard file type of thumb files.
# [operator · string]  default: jpg
# example:
#   DEDALO_THUMB_EXTENSION="jpg"
#DEDALO_THUMB_EXTENSION=jpg

# This parameter defines where the export tool writes the bundles it produces.
# [operator · string]  default: `<media directory>/export/files` — inside the media tree
# example:
#   DEDALO_TOOL_EXPORT_FOLDER_PATH="/srv/exports/dedalo"
#DEDALO_TOOL_EXPORT_FOLDER_PATH=

# This parameter defines the largest file, in BYTES, that Dédalo will accept
# in an upload.
# [operator · int]  default: 2147483648
# example:
#   DEDALO_UPLOAD_MAX_SIZE_BYTES=2147483648
#DEDALO_UPLOAD_MAX_SIZE_BYTES=2147483648

# Defines the size at which files are split into chunks for upload.
# [operator · int || false]  default: 4
# example:
#   # integer = split threshold in MB (e.g. 5 = 5MB); false = disable chunking
#   DEDALO_UPLOAD_SERVICE_CHUNK_FILES=false
#DEDALO_UPLOAD_SERVICE_CHUNK_FILES=4

# Defines the maximum number of simultaneous HTTP requests that can be open to
# the server when uploading a file in chunks.
# [operator · int || false]  default: 50
# example:
#   DEDALO_UPLOAD_SERVICE_MAX_CONCURRENT=50
#DEDALO_UPLOAD_SERVICE_MAX_CONCURRENT=50

# This parameter defines the staging directory where an upload is assembled,
# RELATIVE to the media root (MEDIA_PATH).
# [operator · string]  default: upload/service_upload/tmp
# example:
#   DEDALO_UPLOAD_TMP_SUBDIR="upload/service_upload/tmp"
#DEDALO_UPLOAD_TMP_SUBDIR=upload/service_upload/tmp

# You normally leave this unset. Media files are served by the WEB SERVER,
# which enforces the access rules Dédalo generates for it. But Dédalo can also
# serve them itself, straight from the media root — with no per-record access
# control at all. That fallback exists for the one setup that has no web
# server in the request path: a developer running the engine on its local TCP
# port.
# [operator · true || false]  default: (unset)
# example:
#   MEDIA_DEV_ROUTE_ENABLED=false
#MEDIA_DEV_ROUTE_ENABLED=

# This parameter defines the root media directory in the directory tree.
# [operator · string]  default: `<private dir>/media` — auto-derived; a legacy `<install dir>/media` holding files keeps being used (with a start-up warning) so nothing moves
# example:
#   MEDIA_PATH="/srv/dedalo/media"
#MEDIA_PATH=

# Every time the server starts it walks the media directories, creates any
# that are missing and reports any that are wrong. This parameter is the
# wall-clock budget for that walk.
# [operator · int (milliseconds)]  default: 5000
# example:
#   MEDIA_TREE_BOOT_BUDGET_MS=5000
#MEDIA_TREE_BOOT_BUDGET_MS=5000

# This parameter defines the path to the library, usually xpdf (pdftotext), to
# be used for process the pdf to extract the information, this library will be
# used get the text fo the pdf files and store in the component_text_area. The
# text will be use to search inside the pdf information.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/pdftotext`
# example:
#   PDF_AUTOMATIC_TRANSCRIPTION_ENGINE="/usr/bin/pdftotext"
#PDF_AUTOMATIC_TRANSCRIPTION_ENGINE=

# This parameter defines the path to the library, usually ocrmypdf that will
# be used for OCR processing of the pdf uploaded files. Optical Character
# Recognition or OCR is a technology that converts images of typed or
# handwritten text, such as in a scanned document, into computer text that can
# be selected, searched and copied.
# [operator · string]  default: `<DEDALO_BINARY_BASE>/ocrmypdf`
# example:
#   PDF_OCR_ENGINE="/usr/bin/ocrmypdf"
#PDF_OCR_ENGINE=

# ══════════════════════════════════════════════════════════════════════════════
#  [menu]  Menu variables
# ══════════════════════════════════════════════════════════════════════════════

# This parameter defines the areas that are removed from the installation.
# [operator · array]  default: ["dd137","rsc1","hierarchy20"]
# example:
#   AREAS_DENY=["dd137","rsc1","hierarchy20"]
#AREAS_DENY=["dd137","rsc1","hierarchy20"]

# This parameter defines the tipos to be skipped from the menu.
# [operator · array]  default: []
# example:
#   MENU_SKIP_TIPOS=[]
#MENU_SKIP_TIPOS=[]

# ══════════════════════════════════════════════════════════════════════════════
#  [security]  Security variables
# ══════════════════════════════════════════════════════════════════════════════

# This parameter defines components to be excluded.
# [operator · array]  default: []
# example:
#   DEDALO_AR_EXCLUDE_COMPONENTS=[]
#DEDALO_AR_EXCLUDE_COMPONENTS=[]

# Origins allowed to call this server's JSON API from a browser on another
# origin.
# [operator · array]  default: []
# example:
#   DEDALO_CORS_ALLOWED_ORIGINS=["https://archive.example.org","https://museum.example.org"]
#DEDALO_CORS_ALLOWED_ORIGINS=[]

# This parameter defines if Dédalo will lock / unlock components to avoid
# replacement data when more than one user edit the same component or Dédalo
# do not manage the user edition unlocking all components. By default Dédalo
# do not manage the editions (option false).
# [operator · bool]  default: true
# example:
#   DEDALO_LOCK_COMPONENTS=false
#DEDALO_LOCK_COMPONENTS=true

# This parameter defines if the directory of the media files (av, images, pdf,
# subtitles, ...) will be protected and controlled for undesired/external
# access. The full documentation, with the architecture, use cases, web server
# configuration and examples, is in Media protection (media file access
# control).
# [operator · false | string]  default: publication
# example:
#   DEDALO_MEDIA_ACCESS_MODE=publication
#DEDALO_MEDIA_ACCESS_MODE=publication

# The quality folders an anonymous visitor may read when the record is
# published (rule B). A JSON array, or a comma-separated list. Leave it unset
# to derive the delivery-grade folders from this installation's own quality
# catalog — av/404, av/posterframe, av/subtitles, image/1.5MB, image/thumb,
# image/web, pdf/web, svg/web, 3d/web.
# [operator · string[]]  default: (unset)
# example:
#   # publish the larger image derivative too, and keep thumbnails private
#   DEDALO_MEDIA_PUBLIC_QUALITIES=["image/1.5MB","av/404","av/subtitles"]
#DEDALO_MEDIA_PUBLIC_QUALITIES=

# Only for a server on an IPv6-only network that reaches the IPv4 internet
# through a NAT64 translator using its own network-specific prefix (RFC 6052).
# Leave it empty everywhere else — that is almost every installation.
# [operator · array]  default: []
# example:
#   DEDALO_NAT64_PREFIXES=2001:db8:64::/96
#DEDALO_NAT64_PREFIXES=[]

# This parameter defines if Dédalo will notify to the user than other users
# are editing the same field in the same section when the user try to edit the
# field.
# [operator · bool]  default: false
# example:
#   DEDALO_NOTIFICATIONS=false
#DEDALO_NOTIFICATIONS=false

# The legacy boolean is kept for back-compat: true behaves as
# DEDALO_MEDIA_ACCESS_MODE='private' when the new constant is not defined.
# [operator · bool]  default: false
# example:
#   DEDALO_PROTECT_MEDIA_FILES=false
#DEDALO_PROTECT_MEDIA_FILES=false

# The lifetime, in minutes, that the upload service announces for a queued
# upload session. The engine reports it with the rest of the system
# information, and the upload panel displays it, so a user knows how long
# files that were uploaded but not yet saved into a record remain available in
# the temporary upload directory.
# [operator · int]  default: 180
# example:
#   DEDALO_SESSION_CACHE_EXPIRE=180
#DEDALO_SESSION_CACHE_EXPIRE=180

# Restricts each user to ONE active session. When true, a successful login
# evicts every other session that user already holds (keeping only the one
# just created) — so logging in again anywhere immediately invalidates a token
# stolen earlier, closing the re-login window (security finding AUTHZ-04). A
# password reset already revokes all of a user's sessions regardless of this
# flag; this key extends that guarantee to ordinary re-login.
# [operator · bool]  default: false
# example:
#   DEDALO_SINGLE_SESSION=false
#DEDALO_SINGLE_SESSION=false

# The second dimension of the login throttle: how many failed logins one user
# name may accumulate inside LOGIN_ATTEMPT_WINDOW from any address at all,
# before that account is locked for LOGIN_LOCKOUT_SECONDS. It is what stops an
# attacker who rotates addresses (every new address gets a fresh per-address
# bucket, but they all share this one).
# [operator · int]  default: 50
# example:
#   LOGIN_ACCOUNT_MAX_ATTEMPTS=50
#LOGIN_ACCOUNT_MAX_ATTEMPTS=50

# The third dimension of the login throttle: how many failed logins one
# address may accumulate inside LOGIN_ATTEMPT_WINDOW whatever user name they
# name, before that address is refused for LOGIN_LOCKOUT_SECONDS.
# [operator · int]  default: 100
# example:
#   LOGIN_SOURCE_MAX_ATTEMPTS=100
#LOGIN_SOURCE_MAX_ATTEMPTS=100

# The sliding window, in seconds, over which failed logins are counted for
# both throttle limits (LOGIN_MAX_ATTEMPTS and LOGIN_ACCOUNT_MAX_ATTEMPTS). A
# failure older than the window no longer counts against anyone, and is
# deleted from the store once it can no longer influence a decision.
# [operator · int]  default: 900
# example:
#   LOGIN_ATTEMPT_WINDOW=900
#LOGIN_ATTEMPT_WINDOW=900

# How long, in seconds, a login stays refused once a throttle limit has been
# reached. The lock lifts this long after the most recent counted failure; a
# successful login clears the counters immediately, so a user who finally
# remembers the password is not kept waiting.
# [operator · int]  default: 900
# example:
#   LOGIN_LOCKOUT_SECONDS=900
#LOGIN_LOCKOUT_SECONDS=900

# How many failed logins the same user name may accumulate from the same
# client address inside LOGIN_ATTEMPT_WINDOW before further attempts are
# refused for LOGIN_LOCKOUT_SECONDS. A successful login clears the counter at
# once.
# [operator · int]  default: 10
# example:
#   LOGIN_MAX_ATTEMPTS=10
#LOGIN_MAX_ATTEMPTS=10

# Raw Apache rewrite directives appended to the generated .htaccess
# immediately before the final deny rule. You own their syntax; Dédalo only
# places them.
# [operator · string[]]  default: []
# example:
#   # allow an internal network unconditionally (note the doubled backslashes)
#   MEDIA_HTACCESS_ADDONS=["RewriteCond %{REMOTE_ADDR} ^10\\.0\\.","RewriteRule ^ - [L]"]
#MEDIA_HTACCESS_ADDONS=[]

# Each user's permission table — the grants their profile gives them over
# sections and components — is resolved from the database once and then kept
# in memory. Saving a profile or changing a user's profile drops the cached
# table immediately, so a grant change is normally visible on the next
# request.
# [operator · int]  default: 300
# example:
#   PERMISSIONS_CACHE_TTL_SECONDS=300
#PERMISSIONS_CACHE_TTL_SECONDS=300

# The hard ceiling, in seconds, on a session's life counted from the moment it
# was created — regardless of how active it has been. It exists because an
# idle limit alone (SESSION_TTL_SECONDS) never expires a session that is used
# at least once per window: a stolen cookie would live forever, and a browser
# left open on a workstation renews itself indefinitely through the client's
# own background polling.
# [operator · int]  default: 43200
# example:
#   SESSION_ABSOLUTE_TTL_SECONDS=43200
#SESSION_ABSOLUTE_TTL_SECONDS=43200

# Marks the session cookie Secure, so the browser only ever sends it back over
# HTTPS (the media access cookie carries the same posture). It is true by
# default and it should stay true on anything reachable over a network: a
# session cookie that travels once in clear text is a session an eavesdropper
# can replay.
# [operator · bool]  default: true
# example:
#   SESSION_COOKIE_SECURE=true
#SESSION_COOKIE_SECURE=true

# How long, in seconds, a session survives without being used. Every
# authenticated request refreshes it; a session left untouched for longer than
# this is destroyed and the user must log in again.
# [operator · int]  default: 3600
# example:
#   SESSION_TTL_SECONDS=3600
#SESSION_TTL_SECONDS=3600

# How many seconds before a session expires the client warns the user, so
# unsaved work can be committed (or the session extended — any request extends
# it) instead of the next click failing. Every authenticated response carries
# session_expires_in; the client warns once that value drops below this
# threshold.
# [operator · int]  default: 300
# example:
#   SESSION_WARNING_SECONDS=300
#SESSION_WARNING_SECONDS=300

# ══════════════════════════════════════════════════════════════════════════════
#  [server]  Server and runtime
# ══════════════════════════════════════════════════════════════════════════════

# A code update replaces the installation tree and then exits the server
# process, so that it comes back up running the new code. That only works if
# something restarts it. To avoid taking the server down for good, the update
# refuses to run unless the process was started with DEDALO_SUPERVISED=true.
# [operator · true]  default: (unset)
# example:
#   # systemd unit, [Service] section:   Environment=DEDALO_SUPERVISED=true
#   # compose service, environment: map: DEDALO_SUPERVISED: "true"
#   # inside a shell loop that relaunches the server when it exits:
#   DEDALO_SUPERVISED=true bun run src/server.ts
# (DEDALO_SUPERVISED is not read from this file — set it where the process starts.)

# How many seconds a request may stay idle before the engine drops the
# connection. It applies to both listeners, and it is clamped to the range
# 1–255.
# [operator · int]  default: 255
# example:
#   SERVER_IDLE_TIMEOUT_S=255
#SERVER_IDLE_TIMEOUT_S=255

# The ceiling, in bytes, on the body of any single request the engine accepts.
# Every body is buffered whole in a long-lived process, so an unbounded one is
# a memory-exhaustion hazard — this is the cap that bounds it.
# [operator · int]  default: 268435456
# example:
#   SERVER_MAX_BODY_BYTES=268435456
#SERVER_MAX_BODY_BYTES=268435456

# When the server is asked to stop — a service restart, a deploy, a Ctrl-C —
# it stops accepting new connections and then drains the requests already in
# flight for up to this many milliseconds before it closes the database pool,
# removes the socket file and exits. Users mid-save are not cut off by a
# routine restart.
# [operator · int]  default: 10000
# example:
#   SERVER_SHUTDOWN_GRACE_MS=10000
#SERVER_SHUTDOWN_GRACE_MS=10000

# When set, the engine opens an additional listener on this port, on top of
# the unix socket, and the client is reachable at
# http://localhost:<port>/dedalo/core/page/ — or https://… when
# SERVER_TCP_TLS_CERT_FILE and SERVER_TCP_TLS_KEY_FILE give it a certificate.
# It exists because a browser cannot talk to a unix socket directly, so a
# developer would otherwise need a web server in front of every local
# checkout.
# [operator · int]  default: (unset)
# example:
#   SERVER_TCP_PORT=3000
#SERVER_TCP_PORT=

# The address the development TCP listener (SERVER_TCP_PORT) binds to. Default
# 127.0.0.1: only a browser on the same machine reaches it. A development
# install also shows full error details to the browser
# (DEDALO_DEBUG_API_ERRORS), and this listener has no web server in front of
# it (and no TLS unless SERVER_TCP_TLS_CERT_FILE is set), so it is not opened
# to the network unless you say so.
# [operator · string]  default: 127.0.0.1
# example:
#   SERVER_TCP_HOST=0.0.0.0
#SERVER_TCP_HOST=127.0.0.1

# The certificate (PEM, the leaf first and then any intermediate certificate)
# the development TCP listener (SERVER_TCP_PORT) presents. With it and
# SERVER_TCP_TLS_KEY_FILE set, the listener speaks HTTPS and the boot log
# prints an https:// address; with neither, it serves plain HTTP as before.
# [operator · path]  default: (unset)
# example:
#   SERVER_TCP_TLS_CERT_FILE=/home/me/dedalo/private/tls/fullchain.pem
#SERVER_TCP_TLS_CERT_FILE=

# The private key (PEM) of the certificate in SERVER_TCP_TLS_CERT_FILE. Keep
# the file readable by the account that runs the server and by nobody else
# (mode 0600).
# [operator · path]  default: (unset)
# example:
#   SERVER_TCP_TLS_KEY_FILE=/home/me/dedalo/private/tls/privkey.pem
#SERVER_TCP_TLS_KEY_FILE=

# The unix socket the engine listens on. In production this is the only
# listener: the web server owns TCP and TLS, serves the client files and the
# media, and forwards the API and the dynamic routes to this socket.
# [operator · string]  default: /tmp/dedalo_ts.sock
# example:
#   SERVER_UNIX_SOCKET="/run/dedalo/dedalo_ts.sock"
#SERVER_UNIX_SOCKET=/tmp/dedalo_ts.sock

# Which of this engine's listeners sits behind the reverse proxy, and
# therefore whose X-Forwarded-For header may be believed.
# [operator · socket | tcp | none]  default: socket
# example:
#   TRUSTED_PROXY_TRANSPORT=socket
#TRUSTED_PROXY_TRANSPORT=socket

# How many reverse proxies stand between the internet and the engine. Each one
# appends the address it received the request from to the X-Forwarded-For
# header, so the genuine client address is the entry this many positions from
# the right. Everything further to the left was supplied by the caller and can
# be forged freely.
# [operator · int]  default: 1
# example:
#   TRUSTED_PROXY_HOPS=1
#TRUSTED_PROXY_HOPS=1

# ══════════════════════════════════════════════════════════════════════════════
#  [mailer]  Outbound email and password recovery
# Dédalo relays outbound email (password-recovery codes) through an existing
# mailbox over SMTP — it never runs its own mail server. Leaving
# `DEDALO_SMTP_HOST` empty disables sending entirely, which also disables the
# login screen's password-recovery emails.
# ══════════════════════════════════════════════════════════════════════════════

# The hostname of the SMTP server Dédalo relays outbound email through
# (recovery codes, notifications). Leaving it empty disables the mailer
# entirely — features that need email (the login screen's password recovery)
# will silently skip sending.
# [operator · string]  default: (empty)
# example:
#   DEDALO_SMTP_HOST="smtp.example.org"
#DEDALO_SMTP_HOST=

# The TCP port of the SMTP server. The default 587 is the submission port used
# with STARTTLS; use 465 with DEDALO_SMTP_SECURE='ssl' for implicit TLS.
# [operator · int]  default: 587
# example:
#   DEDALO_SMTP_PORT=587
#DEDALO_SMTP_PORT=587

# How the SMTP connection is encrypted:
#   - 'tls' : STARTTLS on a plain connection (default, pairs with port 587)
#   - 'ssl' : implicit TLS from the first byte (pairs with port 465)
#   - 'none' : no encryption — only ever acceptable for a relay on localhost
# [operator · string]  default: tls
# example:
#   DEDALO_SMTP_SECURE=tls
#DEDALO_SMTP_SECURE=tls

# The SMTP AUTH username (usually the mailbox login). Leave it empty for a
# relay that accepts unauthenticated mail (e.g. a local MTA).
# [operator · string]  default: (empty)
# example:
#   DEDALO_SMTP_USER="dedalo@example.org"
#DEDALO_SMTP_USER=

# The SMTP AUTH password for DEDALO_SMTP_USER. Ignored when the user is empty.
# [secret · string]  default: (empty)
# example:
#   DEDALO_SMTP_PASS="my_smtp_password"
#DEDALO_SMTP_PASS=

# The envelope/header From address of outbound mail. It must be an address the
# relay is allowed to send as (most providers refuse arbitrary senders). When
# empty, DEDALO_SMTP_USER is used; if both are empty the mailer refuses to
# send.
# [operator · string]  default: (empty)
# example:
#   DEDALO_SMTP_FROM="dedalo@example.org"
#DEDALO_SMTP_FROM=

# An optional display name shown next to the From address.
# [operator · string]  default: (empty)
# example:
#   DEDALO_SMTP_FROM_NAME="Dédalo"
#DEDALO_SMTP_FROM_NAME=

# How long, in seconds, an emailed password-recovery code stays valid. The
# code is single-use and its short life is part of what makes the 8-digit
# space safe, so keep this small. Default 600 (10 minutes).
# [operator · int]  default: 600
# example:
#   DEDALO_PWRESET_CODE_TTL=600
#DEDALO_PWRESET_CODE_TTL=600

# How many wrong guesses are allowed against a single issued recovery code
# before it is invalidated and the user must request a new one. Together with
# the short DEDALO_PWRESET_CODE_TTL this caps brute-force odds against the
# 8-digit code at a few in a hundred million. Default 5.
# [operator · int]  default: 5
# example:
#   DEDALO_PWRESET_MAX_ATTEMPTS=5
#DEDALO_PWRESET_MAX_ATTEMPTS=5

# ══════════════════════════════════════════════════════════════════════════════
#  [ops]  Logs, backups and diagnostics
# ══════════════════════════════════════════════════════════════════════════════

# With true, the engine writes one JSON line per API request to its standard
# output: timestamp, request id, user id, the API class and action that was
# called, the response status and the duration in milliseconds. A service
# manager captures it with the rest of the service log, so it can be filtered
# and parsed with the usual tools.
# [operator · bool]  default: false
# example:
#   DEDALO_ACCESS_LOG=false
#DEDALO_ACCESS_LOG=false

# Where the database dumps produced by the maintenance backup tool (and by a
# scheduled nightly backup job) are written. Unset, they go to backups/db
# inside the private directory, next to the configuration file and the session
# store.
# [operator · string]  default: (unset)
# example:
#   DEDALO_BACKUP_DIR="/srv/backups/dedalo/db"
#DEDALO_BACKUP_DIR=

# This parameter defines the directory a code update stages the previous tree
# into before swapping in a new release, so a failed update can be rolled
# back. Keep it outside the served tree for security. Defaults to
# <install>/../backups/code. This is distinct from DEDALO_BACKUP_DIR, which
# sets the directory for database backups (see Database connection).
# [operator · string]  default: (unset)
# example:
#   DEDALO_BACKUP_PATH="/srv/dedalo/backups/code"
#DEDALO_BACKUP_PATH=

# This parameter is the freshness threshold, in hours, applied to database
# backups: it decides when an existing backup is judged too old. It schedules
# NOTHING — no engine event, a user login included, ever starts a backup.
# [operator · int]  default: 8
# example:
#   DEDALO_BACKUP_TIME_RANGE=8
#DEDALO_BACKUP_TIME_RANGE=8

# How long the engine may spend proving that a database backup can be
# restored, in seconds per gigabyte of dump. Before a backup counts — for the
# code updater's "is there a recent backup" check, for the update panel, and
# for a dump the maintenance button just made — the engine reads the whole
# archive back with PostgreSQL's pg_restore, because only a full read can tell
# a complete dump from one that stopped part way. That read gets this many
# seconds for every started gigabyte, and never less than one minute.
# [operator · int]  default: 60
# example:
#   DEDALO_BACKUP_VERIFY_SECONDS_PER_GB=60
#DEDALO_BACKUP_VERIFY_SECONDS_PER_GB=60

# When a request fails unexpectedly, the client is answered with a generic
# message and a request id, while the exception text stays on the server,
# logged under that same id. This is deliberate: the raw text of an error can
# carry query fragments, filesystem paths and internal identifiers, and the
# request id is what lets you find the full story in the log without handing
# any of it to the caller.
# [operator · bool]  default: false
# example:
#   DEDALO_DEBUG_API_ERRORS=true
#DEDALO_DEBUG_API_ERRORS=false

# Marks this installation as a development server. With true, the client is
# told it is talking to a development server so it takes the no-cache path
# instead of the offline service-worker one, the readable, non-minified
# versions of the client libraries are served, and the dev-only client
# libraries the browser test harness needs (mocha/chai) are served. The
# configuration widget in the maintenance area reports the mode it resolved,
# so you can always check what a running server thinks it is.
# [operator · bool]  default: false
# example:
#   DEDALO_DEV_MODE=true bun run dev
#DEDALO_DEV_MODE=false

# This parameter defines where the export tool builds the files a user
# downloads.
# [operator · string]  default: `<private dir>/export_artifacts`
# example:
#   DEDALO_EXPORT_ARTIFACTS_DIR="/srv/dedalo_exports"
#DEDALO_EXPORT_ARTIFACTS_DIR=

# This parameter defines how many bytes of export files one user may hold at
# the same time.
# [operator · int]  default: 10737418240
# example:
#   DEDALO_EXPORT_ARTIFACTS_QUOTA_BYTES=10737418240
#DEDALO_EXPORT_ARTIFACTS_QUOTA_BYTES=10737418240

# This parameter defines how many hours the files of a finished export are
# kept before they are deleted.
# [operator · int]  default: 24
# example:
#   DEDALO_EXPORT_ARTIFACTS_TTL_HOURS=24
#DEDALO_EXPORT_ARTIFACTS_TTL_HOURS=24

# This parameter defines how many exports one user may keep on the server at
# the same time.
# [operator · int]  default: 100
# example:
#   DEDALO_EXPORT_ARTIFACTS_MAX_EXPORTS=100
#DEDALO_EXPORT_ARTIFACTS_MAX_EXPORTS=100

# This parameter defines how many bytes must always stay free on the volume
# that holds the export files (DEDALO_EXPORT_ARTIFACTS_DIR).
# [operator · int]  default: 1073741824
# example:
#   DEDALO_EXPORT_ARTIFACTS_MIN_FREE_BYTES=1073741824
#DEDALO_EXPORT_ARTIFACTS_MIN_FREE_BYTES=1073741824

# This parameter defines how many records the export tool shows per page in
# its preview when the user has not chosen a size.
# [operator · int]  default: 100
# example:
#   DEDALO_EXPORT_PREVIEW_PAGE_SIZE=100
#DEDALO_EXPORT_PREVIEW_PAGE_SIZE=100

# This parameter defines how many export jobs one user may have waiting or
# running at the same time: exports being built plus files being built from
# them.
# [operator · int]  default: 2
# example:
#   DEDALO_EXPORT_JOBS_PER_USER=2
#DEDALO_EXPORT_JOBS_PER_USER=2

# This parameter defines how long, in seconds, an export job may run before
# Dédalo cancels it.
# [operator · int]  default: 0
# example:
#   DEDALO_JOB_DEADLINE_EXPORT_S=0
#DEDALO_JOB_DEADLINE_EXPORT_S=0

# This parameter defines how long, in seconds, a job that builds a file from a
# finished export (a CSV, spreadsheet, HTML page or media ZIP) may run before
# Dédalo cancels it.
# [operator · int]  default: 0
# example:
#   DEDALO_JOB_DEADLINE_EXPORT_FILE_S=0
#DEDALO_JOB_DEADLINE_EXPORT_FILE_S=0

# This parameter defines how long, in seconds, a maintenance job may run
# before Dédalo cancels it.
# [operator · int]  default: 21600
# example:
#   DEDALO_JOB_DEADLINE_MAINTENANCE_S=21600
#DEDALO_JOB_DEADLINE_MAINTENANCE_S=21600

# This parameter defines how long, in seconds, a media job may run before
# Dédalo cancels it.
# [operator · int]  default: 0
# example:
#   DEDALO_JOB_DEADLINE_MEDIA_S=0
#DEDALO_JOB_DEADLINE_MEDIA_S=0

# This parameter defines how long, in seconds, an index-building job may run
# before Dédalo cancels it.
# [operator · int]  default: 3600
# example:
#   DEDALO_JOB_DEADLINE_RAG_S=3600
#DEDALO_JOB_DEADLINE_RAG_S=3600

# This parameter defines how long, in seconds, a transcription job may run
# before Dédalo cancels it.
# [operator · int]  default: 14400
# example:
#   DEDALO_JOB_DEADLINE_TRANSCRIPTION_S=14400
#DEDALO_JOB_DEADLINE_TRANSCRIPTION_S=14400

# This parameter defines how many export jobs Dédalo will run at the same
# time.
# [operator · int]  default: 1
# example:
#   DEDALO_JOB_LANE_EXPORT_CONCURRENCY=1
#DEDALO_JOB_LANE_EXPORT_CONCURRENCY=1

# This parameter defines how many files Dédalo will build from finished
# exports at the same time (the CSV, TSV, HTML, spreadsheet, NDJSON and media
# ZIP downloads).
# [operator · int]  default: 2
# example:
#   DEDALO_JOB_LANE_EXPORT_FILE_CONCURRENCY=2
#DEDALO_JOB_LANE_EXPORT_FILE_CONCURRENCY=2

# This parameter defines how many maintenance jobs Dédalo will run at the same
# time.
# [operator · int]  default: 2
# example:
#   DEDALO_JOB_LANE_MAINTENANCE_CONCURRENCY=2
#DEDALO_JOB_LANE_MAINTENANCE_CONCURRENCY=2

# This parameter defines how many index-building jobs Dédalo will run at the
# same time.
# [operator · int]  default: 2
# example:
#   DEDALO_JOB_LANE_RAG_CONCURRENCY=2
#DEDALO_JOB_LANE_RAG_CONCURRENCY=2

# This parameter defines how many transcription jobs Dédalo will run at the
# same time.
# [operator · int]  default: 2
# example:
#   DEDALO_JOB_LANE_TRANSCRIPTION_CONCURRENCY=2
#DEDALO_JOB_LANE_TRANSCRIPTION_CONCURRENCY=2

# Whether this server runs the scheduled cross-store reconciles by itself: the
# boot-class ones after it starts listening and the interval-class ones on
# their period (the publication-marker index, which re-derives the web
# server's pub/ markers from the per-target truth, runs at both: after the
# listen and every 10 minutes). A run that had to wait for a publication in
# progress past its bound is tried again a minute later, until it completes.
# Every outcome is published under reconcile on /api/v1/counters and listed by
# the Reconcile maintenance widget, which — like bun scripts/reconcile.ts —
# keeps working with the scheduler off; only the automatic runs stop.
# [operator · bool]  default: true
# example:
#   DEDALO_RECONCILE_SCHEDULER_ENABLED=false
#DEDALO_RECONCILE_SCHEDULER_ENABLED=true

# How many days of matrix_activity rows this installation keeps. Every
# state-changing action appends one row — and so does every DENIED login,
# which nobody has to be authenticated to cause — so the table grows with use
# and with abuse alike, inside the database every backup copies.
# [operator · int]  default: 0
# example:
#   DEDALO_ACTIVITY_RETENTION_DAYS=1095
#DEDALO_ACTIVITY_RETENTION_DAYS=0

# How many days of SETTLED rows the dd1758 publication ledger keeps. The
# ledger appends one row per record per publish run — republishing the same
# catalogue writes them all again — so it grows linearly with how often you
# publish, not with how much you hold.
# [operator · int]  default: 0
# example:
#   DEDALO_DIFFUSION_LEDGER_RETENTION_DAYS=365
#DEDALO_DIFFUSION_LEDGER_RETENTION_DAYS=0

# Whether this server applies the configured retention windows by itself, once
# after boot and then daily. With every window at its default (0 = keep
# everything) it has nothing to do, so leaving it on costs nothing and means
# that the day an operator sets a window, it takes effect.
# [operator · bool]  default: true
# example:
#   DEDALO_RETENTION_SCHEDULER_ENABLED=false
#DEDALO_RETENTION_SCHEDULER_ENABLED=true

# Any API request that takes longer than this, in milliseconds, is warn-logged
# with its duration, the API call, the request id and the user — and counted,
# so the count also shows up in the server counters. This happens whether or
# not the access log is on.
# [operator · int]  default: 5000
# example:
#   DEDALO_SLOW_REQUEST_MS=5000
#DEDALO_SLOW_REQUEST_MS=5000

# Defines the directory path to store the update log.
# [operator · string]  default: (unset)
# example:
#   UPDATE_LOG_FILE="/srv/dedalo/private/update.log"
#UPDATE_LOG_FILE=

# ══════════════════════════════════════════════════════════════════════════════
#  [error_report]  Error reporting
# ══════════════════════════════════════════════════════════════════════════════

# Only meaningful on the master installation (the one that receives reports).
# A comma-separated list of the IP addresses allowed to reach the intake; a
# report from any other address is refused. The shorthand loopback accepts the
# local machine. Write every IPv4 part in plain decimal: an entry with a
# leading zero (010.0.0.1) is refused, because some software reads it as octal
# — it matches no address at all.
# [operator · string]  default: (unset)
# example:
#   DEDALO_ERROR_REPORT_ALLOWED_IPS="loopback,203.0.113.10,203.0.113.11"
#DEDALO_ERROR_REPORT_ALLOWED_IPS=

# The JSON API endpoint of the master installation this Dédalo sends its error
# reports to. Setting it is what enables reporting: with a master URL
# configured, global administrators get a report button on every page, from
# which they can describe a problem and send it — together with the page
# context and any JavaScript errors captured since the page loaded — to the
# maintainers. Nothing ever leaves the machine without that explicit click.
# [operator · string]  default: (unset)
# example:
#   DEDALO_ERROR_REPORT_MASTER_URL="https://master.example.org/dedalo/core/api/v1/json/"
#DEDALO_ERROR_REPORT_MASTER_URL=

# Set to true only on the designated master installation — the one other
# Dédalos point at with their master URL. It opens the intake endpoint that
# stores the incoming reports, and it turns on the Error reports widget of the
# maintenance dashboard, where an administrator can browse what has arrived.
# [operator · bool]  default: false
# example:
#   DEDALO_ERROR_REPORT_RECEIVER=true
#DEDALO_ERROR_REPORT_RECEIVER=false

# Only meaningful on the master installation. Received reports older than this
# many days are pruned. Default 90; 0 keeps them forever.
# [operator · int]  default: 90
# example:
#   DEDALO_ERROR_REPORT_RETENTION_DAYS=90
#DEDALO_ERROR_REPORT_RETENTION_DAYS=90

# Only meaningful on the master installation. The highest number of reports
# the store may hold. The age window (DEDALO_ERROR_REPORT_RETENTION_DAYS)
# cannot bound a burst: a flood arriving today is inside the window and stays
# for the whole of it, and since a report may carry an inline screenshot each
# one can be a few hundred kilobytes. When the store is over this ceiling the
# OLDEST reports are dropped until it is under it again — eviction, not
# refusal, because refusing would let a flood silence the genuine reports the
# intake exists for. Default 100000; 0 removes the ceiling.
# [operator · int]  default: 100000
# example:
#   DEDALO_ERROR_REPORT_MAX_ROWS=100000
#DEDALO_ERROR_REPORT_MAX_ROWS=100000

# How long (in milliseconds) this server waits for the master installation to
# accept a relayed report before giving up. Default 10000 (ten seconds),
# minimum 1000.
# [operator · int]  default: 10000
# example:
#   DEDALO_ERROR_REPORT_TIMEOUT_MS=10000
#DEDALO_ERROR_REPORT_TIMEOUT_MS=10000

# An optional shared secret sent with every relayed report and checked by the
# master installation, which rejects a report that does not carry the matching
# value. It is a spam filter, not authentication: the sending server, not the
# browser, adds it.
# [secret · string]  default: (unset)
# example:
#   DEDALO_ERROR_REPORT_TOKEN="a-long-random-shared-secret"
#DEDALO_ERROR_REPORT_TOKEN=

# ══════════════════════════════════════════════════════════════════════════════
#  [ai]  AI assistant, agent and semantic search
# ══════════════════════════════════════════════════════════════════════════════

# This parameter names the model the assistant uses when no model catalog is
# declared. It only matters in the zero-configuration case: with
# DEDALO_AGENT_MODELS unset and an ANTHROPIC_API_KEY present, Dédalo builds an
# implicit one-model catalog and this is the model id it asks for. As soon as
# you declare an explicit catalog, this parameter is ignored — each catalog
# entry carries its own model id.
# [operator · string]  default: claude-opus-4-8
# example:
#   AGENT_MODEL="claude-opus-4-8"
#AGENT_MODEL=claude-opus-4-8

# The credential the assistant sends to Anthropic. It is used by every catalog
# entry whose provider is anthropic and does not name its own key variable,
# and it is what makes the implicit (zero-configuration) catalog exist at all:
# with no key and no DEDALO_AGENT_MODELS, the assistant has no models and
# stays disabled.
# [secret · string]  default: (unset)
# example:
#   ANTHROPIC_API_KEY="sk-ant-..."
#ANTHROPIC_API_KEY=

# This parameter decides whether a conversation held with an external model
# (one whose catalog egress class is external — any model whose API call
# leaves your server) may receive the content of your records at all. It is
# the privacy switch for institutions whose data may not leave the building.
# [operator · bool]  default: false
# example:
#   DEDALO_AGENT_ALLOW_EXTERNAL_PROVIDER_DEFAULT=false
#DEDALO_AGENT_ALLOW_EXTERNAL_PROVIDER_DEFAULT=false

# This parameter exposes the assistant's write tools and the change-plan flow.
# With the default false the assistant is strictly read-only: the write tools
# are not even listed to the model, and a call to one is refused.
# [operator · bool]  default: false
# example:
#   DEDALO_AGENT_ALLOW_WRITE=false
#DEDALO_AGENT_ALLOW_WRITE=false

# The master switch for the assistant inside the Dédalo client: the chat
# panel, the model list, and the streaming answer. With the default false
# every assistant request is refused like an unknown action, and the panel
# reports the feature as disabled — the rest of the application is unaffected.
# [operator · bool]  default: false
# example:
#   DEDALO_AGENT_HTTP_ENABLED=true
#DEDALO_AGENT_HTTP_ENABLED=false

# The maximum number of tokens the assistant may produce in a single model
# turn. It caps the length of one answer (and the cost of one runaway
# generation); it does not cap the conversation, which may take several turns.
# [operator · int]  default: 16000
# example:
#   DEDALO_AGENT_MAX_TOKENS=16000
#DEDALO_AGENT_MAX_TOKENS=16000

# The list of models the assistant may use — the one place a deployment
# declares what the user can pick from, and where each model's answers travel.
# It is a JSON array; each entry takes id, label (what the user sees),
# provider (anthropic or openai_compatible), model (the provider's own model
# id), and optionally endpoint, api_key_env (the NAME of another variable
# holding the key — never the key itself), egress (local or external), vision,
# max_tokens and timeout_s. The first entry is the default choice.
# [operator · array of objects (JSON)]  default: (unset)
# example:
#   DEDALO_AGENT_MODELS=[{"id":"local","label":"Llama 3.1 (local, private)","provider":"openai_compatible","model":"llama3.1:70b","endpoint":"http://127.0.0.1:11434/v1/chat/completions","egress":"local"},{"id":"claude","label":"Claude (external)","provider":"anthropic","model":"claude-opus-4-8","vision":true}]
#DEDALO_AGENT_MODELS=

# Free text appended to the assistant's built-in instructions, so it knows
# where it is working. Use it for the facts a model cannot guess: what the
# institution holds, which language its labels are in, which collection is the
# important one.
# [operator · string]  default: (unset)
# example:
#   DEDALO_AGENT_SYSTEM_PROMPT_APPEND="This is the archive of the Museum of X. Prefer Catalan (lg-cat) labels when they exist. The oral-history collection is sensitive."
#DEDALO_AGENT_SYSTEM_PROMPT_APPEND=

# A comma-separated list of section tipos the assistant's change plans may
# touch. It narrows write mode to the part of the repository you are willing
# to let a model propose edits in — a cataloguing section, say, and nothing
# else. A plan naming any other section is refused before it reaches the
# database.
# [operator · string[]]  default: (unset)
# example:
#   DEDALO_AGENT_WRITE_SECTIONS=oh1,rsc197
#DEDALO_AGENT_WRITE_SECTIONS=

# Exposes the write tools in the stand-alone tool server — the separate
# process that offers Dédalo's tools to an external AI client over a local
# pipe. With the default false that server registers read tools only, and a
# write call is refused as read-only.
# [operator · bool]  default: false
# example:
#   DEDALO_MCP_ALLOW_WRITE=false
#DEDALO_MCP_ALLOW_WRITE=false

# The one directory from which the stand-alone tool server may ingest a media
# file by path. Unset by default, and unset means the whole path-based branch
# is disabled: a tool call that names a file path is refused, and media can
# only be uploaded as inline data.
# [operator · string]  default: (unset)
# example:
#   DEDALO_MCP_MEDIA_IMPORT_DIR="/var/dedalo/ingest"
#DEDALO_MCP_MEDIA_IMPORT_DIR=

# The largest media file, in bytes, the stand-alone tool server will accept in
# one upload tool call — whether it arrives as inline data or from the import
# directory. Anything larger is refused with a "too large" message.
# [operator · int]  default: 10485760
# example:
#   DEDALO_MCP_MEDIA_MAX_BYTES=10485760
#DEDALO_MCP_MEDIA_MAX_BYTES=10485760

# The Dédalo user the stand-alone tool server acts as. That server has no
# login: it resolves this one identity at startup and keeps it for the whole
# process lifetime — every tool call it serves is authorized against this
# user's permissions and record scope, exactly as if that person had done it
# in the client. There is no tool to change identity mid-flight.
# [operator · int]  default: (unset)
# example:
#   DEDALO_MCP_USER_ID=42
#DEDALO_MCP_USER_ID=

# A comma-separated list of section tipos the stand-alone tool server's write
# tools may target. A write call addressing any other section is refused
# before the engine is reached.
# [operator · string[]]  default: (unset)
# example:
#   DEDALO_MCP_WRITE_SECTIONS=rsc197
#DEDALO_MCP_WRITE_SECTIONS=

# How many text fragments Dédalo sends to the embedding service in one request
# while indexing. It is a throughput knob for the indexer, invisible to end
# users.
# [operator · int]  default: 32
# example:
#   DEDALO_RAG_BATCH_SIZE=32
#DEDALO_RAG_BATCH_SIZE=32

# How Dédalo cuts a long text into the fragments it indexes for semantic
# search. Two strategies exist:
#   - structural_semantic (the default) — split on the text's own structure
#     (headings,
#   - structural — split on structure only. Cheaper and fully deterministic; a
#     reasonable
# [operator · string]  default: structural_semantic
# example:
#   DEDALO_RAG_CHUNK_STRATEGY="structural_semantic"
#DEDALO_RAG_CHUNK_STRATEGY=structural_semantic

# The largest fragment, in tokens, the chunker will emit. Bigger fragments
# carry more context into an answer but blur the match — the embedding of a
# long passage is an average of everything in it, so a precise question
# retrieves it less sharply. Smaller fragments match precisely but may arrive
# without the sentence that explains them.
# [operator · int]  default: 450
# example:
#   DEDALO_RAG_CHUNK_TOKENS=450
#DEDALO_RAG_CHUNK_TOKENS=450

# The floor, in tokens, below which the chunker will not leave a fragment
# standing on its own: a shorter one is merged into its neighbour. Without a
# floor, a heading or a one-line field becomes a fragment of its own, and such
# a fragment matches many questions weakly and none of them well.
# [operator · int]  default: 120
# example:
#   DEDALO_RAG_CHUNK_MIN_TOKENS=120
#DEDALO_RAG_CHUNK_MIN_TOKENS=120

# Under the structural_semantic strategy, how different two consecutive
# passages must be before the chunker cuts between them. It is a similarity
# threshold between 0 and 1: the cut is made when similarity falls below it.
# [operator · float]  default: 0.92
# example:
#   DEDALO_RAG_SEMANTIC_BREAKPOINT_THRESHOLD=0.92
#DEDALO_RAG_SEMANTIC_BREAKPOINT_THRESHOLD=0.92

# The host of the vector database. Set it only when the semantic index lives
# on a different database server than the catalogue: when unset (the default),
# Dédalo reuses the main database's route (its socket DB_SOCKET when set, else
# DB_HOST), and the same goes for DEDALO_RAG_DB_PORT_CONN,
# DEDALO_RAG_DB_USERNAME_CONN and DEDALO_RAG_DB_PASSWORD_CONN. The typical
# installation sets none of them.
# [operator · string]  default: (unset)
# example:
#   DEDALO_RAG_DB_HOSTNAME_CONN="10.0.0.42"
#DEDALO_RAG_DB_HOSTNAME_CONN=

# The name of the database that holds the semantic index — the vectors and the
# indexed text fragments. It is deliberately separate from the catalogue
# database: nothing in it is irreplaceable, since the whole index can be
# rebuilt from the records at any time.
# [operator · string]  default: (unset)
# example:
#   DEDALO_RAG_DB_NAME="dedalo7_rag"
#DEDALO_RAG_DB_NAME=

# The password used to connect to the vector database. Needed only when the
# semantic index lives on a different database server (or under a different
# role) than the catalogue: unset, Dédalo reuses the main database password.
# [secret · string]  default: (unset)
# example:
#   DEDALO_RAG_DB_PASSWORD_CONN="•••••"
#DEDALO_RAG_DB_PASSWORD_CONN=

# The port of the vector database server. Set it only when the semantic index
# lives on a different server, or on a non-standard port; unset (the default),
# Dédalo reuses the main database's port. A value that is not a positive
# number is ignored and the main database's port is used.
# [operator · int]  default: (unset)
# example:
#   DEDALO_RAG_DB_PORT_CONN=5432
#DEDALO_RAG_DB_PORT_CONN=

# The Unix socket directory of the vector database, for a local connection
# that does not go through the network stack. When set it wins over the host
# and port settings.
# [operator · string]  default: (empty)
# example:
#   DEDALO_RAG_DB_SOCKET_CONN="/var/run/postgresql"
#DEDALO_RAG_DB_SOCKET_CONN=

# The role used to connect to the vector database. Set it only when the
# semantic index lives on a different database server, or is owned by a
# different role, than the catalogue; unset (the default), Dédalo reuses the
# main database user.
# [operator · string]  default: (unset)
# example:
#   DEDALO_RAG_DB_USERNAME_CONN="dedalo"
#DEDALO_RAG_DB_USERNAME_CONN=

# The base URL of the embedding service that turns text into vectors. It is
# required for real semantic search: with
# DEDALO_RAG_EMBEDDING_PROVIDER=sidecar but no endpoint, Dédalo silently keeps
# the built-in development embedder, whose results are reproducible but not
# meaningful.
# [operator · string]  default: (empty)
# example:
#   DEDALO_RAG_EMBEDDING_ENDPOINT="http://127.0.0.1:8085"
#DEDALO_RAG_EMBEDDING_ENDPOINT=

# The model name Dédalo asks the embedding service for. It is also the
# partition key of the semantic index: vectors are stored per model, so two
# models never contaminate each other's results.
# [operator · string]  default: bge-m3
# example:
#   DEDALO_RAG_EMBEDDING_MODEL="bge-m3"
#DEDALO_RAG_EMBEDDING_MODEL=bge-m3

# Which embedder produces the vectors behind semantic search. Set it to
# sidecar to use a real embedding service — and then
# DEDALO_RAG_EMBEDDING_ENDPOINT must be set too, or Dédalo falls back to the
# built-in one.
# [operator · string]  default: (empty)
# example:
#   DEDALO_RAG_EMBEDDING_PROVIDER="sidecar"
#DEDALO_RAG_EMBEDDING_PROVIDER=

# The master switch for semantic search: the vector index, the indexing that
# follows a save, and the search and question-answering actions built on them.
# With the default false the subsystem costs nothing — no indexing work is
# queued when a record is saved, and every semantic-search request is
# declined.
# [operator · bool]  default: false
# example:
#   DEDALO_RAG_ENABLED=true
#DEDALO_RAG_ENABLED=false

# A comma-separated list of section tipos whose content must never reach a
# model hosted outside your server — the never-egress list. It is the one
# place an institution names its protected material (an oral-history
# collection, a donor file), and it is honoured by both AI surfaces: the
# assistant's conversations and the semantic question-answering. One
# classification, applied twice.
# [operator · string[]]  default: (unset)
# example:
#   DEDALO_RAG_EXTERNAL_PROVIDER_FORBIDDEN_SECTIONS=oh1,rsc45
#DEDALO_RAG_EXTERNAL_PROVIDER_FORBIDDEN_SECTIONS=

# The master switch for the IMAGE half of semantic search: visual similarity
# between objects, a typed question answered with photographs, and the
# neighbour-based characterization of an uncatalogued piece. With the default
# false those three actions decline as unavailable and nothing else changes —
# the text side of semantic search is untouched.
# [operator · bool]  default: false
# example:
#   DEDALO_RAG_MEDIA_ENABLED=true
#DEDALO_RAG_MEDIA_ENABLED=false

# Which service turns an image into a vector — and, the load-bearing part,
# whether that service runs on your own machine. local (the default) declares
# an on-premise image embedder; any other value declares an external one,
# whose every call carries the image itself off your server.
# [operator · string]  default: local
# example:
#   DEDALO_RAG_MULTIMODAL_PROVIDER="local"
#DEDALO_RAG_MULTIMODAL_PROVIDER=local

# The model name Dédalo asks the image embedding service for. It must be a
# joint image-and-text model (CLIP, SigLIP, jina-clip and their kin): both of
# its towers share one vector space, and that shared space is what lets a
# typed question retrieve a photograph. A text-only embedder cannot stand in
# here — the text-side DEDALO_RAG_EMBEDDING_MODEL is a separate, independent
# choice.
# [operator · string]  default: clip-ViT-B-32
# example:
#   DEDALO_RAG_MULTIMODAL_MODEL="clip-ViT-B-32"
#DEDALO_RAG_MULTIMODAL_MODEL=clip-ViT-B-32

# The base URL of the image embedding service. Dédalo posts images to
# {endpoint}/image and query text to {endpoint}/text, and expects the vectors
# back; a failed or mis-shaped response is skipped whole rather than stored as
# a partial batch, so a sick service degrades the results but never corrupts
# the index.
# [operator · string]  default: (empty)
# example:
#   DEDALO_RAG_MULTIMODAL_ENDPOINT="http://127.0.0.1:8089"
#DEDALO_RAG_MULTIMODAL_ENDPOINT=

# The bearer token Dédalo sends to the image embedding service. A container
# you run yourself usually needs none; a hosted service always does.
# [secret · string]  default: (unset)
# example:
#   DEDALO_RAG_MULTIMODAL_API_KEY="sk-..."
#DEDALO_RAG_MULTIMODAL_API_KEY=

# Whether the photographs of your objects may be sent to an embedding service
# outside your server. It is the institution's own decision, stated once:
#   - local_only (the default) — images are embedded only by a provider
#     declared local
#   - allow_external — an external provider is permitted, because the
#     institution has
# [operator · string]  default: local_only
# example:
#   DEDALO_RAG_IMAGE_EGRESS_POLICY="local_only"
#DEDALO_RAG_IMAGE_EGRESS_POLICY=local_only

# The longest side, in pixels, of the copy of an image that is sent to the
# embedding service. A larger original is downscaled into that box first; one
# already inside it is sent untouched. The original file on disk is never
# modified.
# [operator · int]  default: 512
# example:
#   DEDALO_RAG_IMAGE_MAX_PX=512
#DEDALO_RAG_IMAGE_MAX_PX=512

# Whether an object-similarity search combines the visual match with a lexical
# one over the object's own descriptive context, when the request does not say
# which mode it wants.
# [operator · bool]  default: true
# example:
#   DEDALO_RAG_IMAGE_HYBRID=true
#DEDALO_RAG_IMAGE_HYBRID=true

# How alike two images must be, on a 0-to-1 similarity scale, before a
# near-duplicate search reports them as the same thing. It applies only to a
# request that explicitly asks for near duplicates; ordinary similarity
# searches are unaffected.
# [operator · float]  default: 0.93
# example:
#   DEDALO_RAG_NEAR_DUPLICATE_SIMILARITY=0.93
#DEDALO_RAG_NEAR_DUPLICATE_SIMILARITY=0.93

# How many visually nearest already-catalogued objects are consulted when
# Dédalo proposes a typology, a period or a material for an uncatalogued one.
# The proposal is an aggregate of what those neighbours are catalogued as —
# never a generated guess — and it is returned for a cataloguer to accept or
# reject: the engine writes nothing.
# [operator · int]  default: 20
# example:
#   DEDALO_RAG_CHARACTERIZE_TOP_K=20
#DEDALO_RAG_CHARACTERIZE_TOP_K=20

# How long, in seconds, Dédalo waits for the embedding service to answer one
# batch before giving up on it. A timed-out batch is a retryable indexing
# failure, never a partial write.
# [operator · int]  default: 30
# example:
#   DEDALO_RAG_PROVIDER_TIMEOUT=30
#DEDALO_RAG_PROVIDER_TIMEOUT=30

# A tuning constant of the hybrid ranking. A semantic search runs two searches
# — one on meaning (vectors), one on words (full text) — and merges the two
# rankings by position rather than by score, since the scores are not
# comparable. This value damps how much the very top positions dominate that
# merge.
# [operator · int]  default: 60
# example:
#   DEDALO_RAG_RRF_K=60
#DEDALO_RAG_RRF_K=60

# Where the models that run inside the browser are kept — speech recognition
# for the transcription tool, translation for the language tool. The directory
# is served read-only at /dedalo/ai_models/, one folder per model, to
# logged-in users only — the weights are large and served with a long-lived
# cache, so an anonymous request is refused with the same 404 as a missing
# model.
# [operator · path]  default: (unset)
# example:
#   DEDALO_AI_MODEL_STORE="/data/dedalo/ai_models"
#DEDALO_AI_MODEL_STORE=

# Whether the browser may fetch model weights from a public model hub when
# they are not in the local store.
# [operator · bool]  default: false
# example:
#   DEDALO_AI_MODEL_ALLOW_HUB=false
#DEDALO_AI_MODEL_ALLOW_HUB=false

# Whether a configured transcription server may live on a private or loopback
# address.
# [operator · bool]  default: false
# example:
#   DEDALO_TRANSCRIBER_ALLOW_PRIVATE_HOSTS=true
#DEDALO_TRANSCRIBER_ALLOW_PRIVATE_HOSTS=false

# The compatibility spelling of the vector-database name, still honoured so
# that an installation configured before DEDALO_RAG_DB_NAME existed keeps
# working untouched.
# [operator · string]  default: dedalo7_rag
# example:
#   RAG_DB_NAME="dedalo7_rag"
#RAG_DB_NAME=dedalo7_rag

# ══════════════════════════════════════════════════════════════════════════════
#  [external]  External record services
# Some ontology nodes resolve their values from a service outside Dédalo (a
# bibliographic catalogue, an authority file) rather than from the records
# stored here. These settings govern that outbound side: whether it runs at
# all, which hosts it may reach — nowhere, until you say so — and the ceilings
# that keep a slow or hostile service from becoming a slow or broken Dédalo.
# ══════════════════════════════════════════════════════════════════════════════

# The master switch for every outbound record lookup. With it on (the
# default), a component whose ontology declares a service other than Dédalo's
# own may resolve its values from that service; with it off, every such
# component resolves to nothing and every outbound call is refused — the rest
# of the application is untouched, and no record stored in the matrix changes.
# [operator · bool]  default: true
# example:
#   DEDALO_EXTERNAL_ENABLED=true
#DEDALO_EXTERNAL_ENABLED=true

# A comma-separated list of service names that must not be contacted, while
# the rest of the subsystem keeps working. It is the per-service kill switch:
# when one catalogue is down, misbehaving, or has become a legal problem, you
# name it here instead of turning the whole outbound side off.
# [operator · string[]]  default: (empty)
# example:
#   DEDALO_EXTERNAL_DISABLED_SERVICES=zenon
#DEDALO_EXTERNAL_DISABLED_SERVICES=

# The comma-separated list of host names the engine may send an outbound
# record request to. Read the default carefully, because it inverts the usual
# reading of an empty list: empty means every outbound request is REFUSED. The
# allowlist is not a narrowing of an otherwise open door — it is the door.
# [operator · string[]]  default: (empty)
# example:
#   DEDALO_EXTERNAL_ALLOWED_HOSTS=zenon.dainst.org
#DEDALO_EXTERNAL_ALLOWED_HOSTS=

# How long, in milliseconds, the engine waits for one outbound response before
# giving up. It is what keeps a slow third party from becoming a slow Dédalo:
# an editor opening a record must not sit behind someone else's overloaded
# server.
# [operator · int]  default: 4000
# example:
#   DEDALO_EXTERNAL_TIMEOUT_MS=4000
#DEDALO_EXTERNAL_TIMEOUT_MS=4000

# The largest response, in bytes, the engine will read from an external
# service. Reading stops at the ceiling and the lookup fails; it is never
# truncated into a value, because half a document parsed as a whole one is
# worse than no document.
# [operator · int]  default: 2097152
# example:
#   DEDALO_EXTERNAL_MAX_BYTES=2097152
#DEDALO_EXTERNAL_MAX_BYTES=2097152

# How many outbound requests may be in flight at once towards one service on
# one host. Further requests wait for a slot rather than being refused.
# [operator · int]  default: 4
# example:
#   DEDALO_EXTERNAL_MAX_CONCURRENCY=4
#DEDALO_EXTERNAL_MAX_CONCURRENCY=4

# How old, in milliseconds, a cached external row may get before the engine
# asks the service for it again. It is a SOFT age: a row past it is still
# served — immediately, from the cache — and the refresh happens behind the
# request. An editor never waits on a third party for data Dédalo already has.
# [operator · int]  default: 300000
# example:
#   DEDALO_EXTERNAL_SOFT_TTL_MS=300000
#DEDALO_EXTERNAL_SOFT_TTL_MS=300000

# How many further attempts one outbound lookup makes after the first one
# fails, with a growing pause between them. Only failures that a retry could
# plausibly fix are retried — a dropped connection, a timeout, a "try later"
# from the service. A refusal, a not-found or a malformed document is final
# and is not repeated.
# [operator · int]  default: 2
# example:
#   DEDALO_EXTERNAL_RETRY_ATTEMPTS=2
#DEDALO_EXTERNAL_RETRY_ATTEMPTS=2

# How long, in milliseconds, the engine stops calling a service after it has
# failed repeatedly. During the cooldown every lookup for that service fails
# instantly from cached data or from nothing at all — no connection is
# attempted.
# [operator · int]  default: 60000
# example:
#   DEDALO_EXTERNAL_BREAKER_COOLDOWN_MS=60000
#DEDALO_EXTERNAL_BREAKER_COOLDOWN_MS=60000

# The longest single value, in characters, the engine will emit from an
# external record. A longer one is refused rather than cut: a silently
# shortened title is a wrong title, and it would look exactly like a real one.
# [operator · int]  default: 8192
# example:
#   DEDALO_EXTERNAL_MAX_ENTRY_CHARS=8192
#DEDALO_EXTERNAL_MAX_ENTRY_CHARS=8192

# How many values one external component may emit for one record — the count
# ceiling beside the length ceiling. A response offering more is cut to this
# many, and the fact that it was cut is reported rather than hidden.
# [operator · int]  default: 50
# example:
#   DEDALO_EXTERNAL_MAX_ENTRIES=50
#DEDALO_EXTERNAL_MAX_ENTRIES=50

# The credential sent to the Zenon bibliographic service. Zenon's public
# interface needs none today, so this is unset by default and unset simply
# means the request carries no authorization header — the lookup works exactly
# as before.
# [secret · string]  default: (unset)
# example:
#   DEDALO_EXTERNAL_ZENON_API_KEY="•••••"
#DEDALO_EXTERNAL_ZENON_API_KEY=

# ══════════════════════════════════════════════════════════════════════════════
#  [tools]  Tools
# ══════════════════════════════════════════════════════════════════════════════

# This parameter defines extra directories where Dédalo will look for tools,
# besides the tools/ directory of the installation itself.
# [operator · array of objects]  default: (unset)
# example:
#   DEDALO_ADDITIONAL_TOOLS=[{"path":"/srv/custom_tools","url":"/custom_tools"}]
#DEDALO_ADDITIONAL_TOOLS=

# This parameter defines the directory holding the transform definition files
# — the JSON declarations that drive the move_ maintenance widgets (move a
# tipo, move a locator, move data into a portal or into a table, move a
# language).
# [operator · string]  default: `<private dir>/transform_definition_files` — a legacy `<install dir>/install/transform_definition_files` holding files keeps being used so nothing moves
# example:
#   DEDALO_TRANSFORM_DEFINITIONS_DIR="/srv/dedalo_transforms"
#DEDALO_TRANSFORM_DEFINITIONS_DIR=

# This parameter defined how long, in milliseconds, the server kept the tools
# registry in memory before reading it from the database again.
# [operator · int]  default: 60000
# example:
#   TOOLS_REGISTRY_CACHE_TTL_MS=60000
#TOOLS_REGISTRY_CACHE_TTL_MS=60000

# ══════════════════════════════════════════════════════════════════════════════
#  [sitebuilder]  Site builder
# ══════════════════════════════════════════════════════════════════════════════

# This parameter is the base URL of the Site Builder service — the standalone
# daemon that lets your users build their own public websites over the
# published data by talking to a coding agent.
# [operator · string]  default: (unset)
# example:
#   DEDALO_SITE_BUILDER_URL="https://sites.example.org/publication/site_builder"
#DEDALO_SITE_BUILDER_URL=

# The absolute path of the unix socket the Site Builder daemon listens on, for
# a daemon installed on this same machine. When it is set, the socket is the
# transport: the engine dials it directly and never opens a network
# connection.
# [operator · string]  default: (unset)
# example:
#   DEDALO_SITE_BUILDER_SOCKET="/run/dedalo-sites/example/daemon.sock"
#DEDALO_SITE_BUILDER_SOCKET=

# The name of the site-builder instance — the tenancy — this install is paired
# with. One museum is one Dédalo install and one site-builder instance, so
# this is a single fixed name, never a list and never something a user chooses
# at run time.
# [operator · string]  default: (unset)
# example:
#   DEDALO_SITE_BUILDER_INSTANCE="example"
#DEDALO_SITE_BUILDER_INSTANCE=

# The shared bearer token the engine presents to the Site Builder daemon on
# every call. It MUST equal the daemon's own SERVICE_TOKEN (the daemon's
# installer generates one and prints it).
# [secret · string]  default: (unset)
# example:
#   DEDALO_SITE_BUILDER_TOKEN="..."
#DEDALO_SITE_BUILDER_TOKEN=

# How long, in milliseconds, the engine waits for a JSON response from the
# Site Builder daemon before giving up and reporting the service unreachable.
# It bounds the ordinary control calls (list sites, start a session, trigger a
# build); the live event stream a session produces is NOT subject to it — a
# streamed turn may run for many minutes.
# [operator · int]  default: 10000
# example:
#   DEDALO_SITE_BUILDER_TIMEOUT_MS=10000
#DEDALO_SITE_BUILDER_TIMEOUT_MS=10000

# ══════════════════════════════════════════════════════════════════════════════
#  [install]  Install
# ══════════════════════════════════════════════════════════════════════════════

# This parameter defines the directory the installer WRITES to — the
# configuration file it persists, the state file, the sessions and the
# backups.
# [operator · string]  default: (unset)
# example:
#   DEDALO_INSTALL_PRIVATE_DIR="/srv/dedalo_private"
#DEDALO_INSTALL_PRIVATE_DIR=

# ══════════════════════════════════════════════════════════════════════════════
#  [maintenance]  Maintenance variables
# ══════════════════════════════════════════════════════════════════════════════

# This parameter defines the code servers this install offers releases from.
# Each entry is a JSON object with name, url and code; add entries to the
# array to offer mirror servers too.
# [operator · array]  default: (unset)
# example:
#   CODE_SERVERS=[{"name":"Official Dédalo code server","url":"https://v7.master.dedalo.dev/dedalo/core/api/v1/json/","code":"x3a0B4Y020Eg9w"}]
#CODE_SERVERS=

# How many code restore points this installation keeps on disk.
# [operator · number]  default: 3
# example:
#   DEDALO_CODE_RESTORE_POINTS_KEEP=3
#DEDALO_CODE_RESTORE_POINTS_KEEP=3

# This parameter defines the path to the release archives on a code server.
# Releases are organised in version directories,
# <major>/<major.minor>/<version>.zip, each next to its .sha256 sidecar:
# [operator · string]  default: (unset)
# example:
#   DEDALO_CODE_FILES_DIR="/srv/dedalo/code"
#DEDALO_CODE_FILES_DIR=

# This parameter defines the path to git directory in the server. It use to
# build the version with for specific version. GIT directory is a valid git
# server than can provide the build version. This parameter is not necessary
# if the server will be only a mirror from official files.
# [operator · string]  default: (unset)
# example:
#   DEDALO_CODE_SERVER_GIT_DIR="/my_dedalo_git_directory"
#DEDALO_CODE_SERVER_GIT_DIR=

# This parameter lets a code server OFFER developer builds (<version>-dev.zip,
# built from the tip of the master branch) to installations that explicitly
# ask for them. Published releases (<version>.zip) are built from release tags
# (vX.Y.Z) and are offered regardless of this setting.
# [operator · bool]  default: false
# example:
#   DEDALO_CODE_SERVER_DEV_CHANNEL=true
#DEDALO_CODE_SERVER_DEV_CHANNEL=false

# This parameter lets a code server OFFER prereleases (<version>-beta.N.zip,
# built from a prerelease tag such as v7.0.1-beta.2, or -alpha.N / -rc.N) to
# installations that explicitly ask for them. Published releases
# (<version>.zip) are offered regardless of this setting.
# [operator · bool]  default: false
# example:
#   DEDALO_CODE_SERVER_PRERELEASE_CHANNEL=true
#DEDALO_CODE_SERVER_PRERELEASE_CHANNEL=false

# Not honoured by the engine. A code update downloads and stages the new
# release in .code_staging under the code-backup root
# (<DEDALO_BACKUP_PATH>/.code_staging), whatever this key says. Setting it has
# no effect on staging; it is a retirement candidate.
# [operator · string]  default: (unset)
# example:
#   DEDALO_SOURCE_VERSION_LOCAL_DIR="/tmp/my_museum"
#DEDALO_SOURCE_VERSION_LOCAL_DIR=

# This parameter defines if the server can provide code to other Dédalo
# servers. By default no Dédalo server provides code, but it is possible to
# set one up as a mirror server that provides code versions. To enable it,
# also set DEDALO_CODE_FILES_DIR — the URL other servers fetch from is derived
# automatically.
# [operator · bool]  default: false
# example:
#   IS_A_CODE_SERVER=false
#IS_A_CODE_SERVER=false

# It defines if the installation server can provide his ontology files to
# other Dédalo servers.
# [operator · bool]  default: false
# example:
#   IS_AN_ONTOLOGY_SERVER=false
#IS_AN_ONTOLOGY_SERVER=false

# This parameter defines where the ontology recovery file is written and read.
# Before an ontology update, Dédalo dumps the whitelisted slice of the
# ontology into this gzipped SQL file, so a failed update can be examined and
# the previous definitions restored.
# [operator · string]  default: `<private dir>/db/dd_ontology_recovery.sql.gz`
# example:
#   DEDALO_ONTOLOGY_RECOVERY_PATH="/srv/dedalo_private/db/dd_ontology_recovery.sql.gz"
#DEDALO_ONTOLOGY_RECOVERY_PATH=

# This parameter defines the directory to input/output the ontology files in
# the server. Ontology files can be created by master ontology servers or
# downloaded from an external provider such as the official master Dédalo
# server.
# [operator · string]  default: `<private dir>/import/ontology`; an install whose legacy `<install dir>/install/import/ontology` holds anything that is not an ontology release file (or that is an ontology server) keeps the legacy dir until that private directory exists
# example:
#   ONTOLOGY_DATA_IO_DIR="/srv/dedalo/ontology"
#ONTOLOGY_DATA_IO_DIR=

# It defines the valid code for clients to validate to get ontology files.
# [operator · string]  default: (unset)
# example:
#   ONTOLOGY_SERVER_CODE="x3a0B4Y020Eg9w"
#ONTOLOGY_SERVER_CODE=

# This parameter defines the ontology master servers to get the ontology
# updates. The servers could be:
#   - the official dedalo.dev server
#   - an external server for local Ontologies (private Ontologies of
#     entities.)
#   - local server, the current installation
# [operator · array of objects]  default: (unset)
# example:
#   ONTOLOGY_SERVERS=[{"name":"Official Dédalo Ontology server","url":"https://v7.master.dedalo.dev/dedalo/core/api/v1/json/","code":"x3a0B4Y020Eg9w"}]
#ONTOLOGY_SERVERS=

# Not honoured by the engine. The key is still parsed, but nothing reads the
# value: it has no effect on ontology updates, which are run from the Update
# ontology panel against the masters in ONTOLOGY_SERVERS. A v6 .env that
# carries it keeps booting; the line can be removed. It is a retirement
# candidate.
# [operator · true || false]  default: (unset)
# example:
#   STRUCTURE_FROM_SERVER=true
#STRUCTURE_FROM_SERVER=

# Enables the built-in, self-hosted IP to Country resolution used in section
# Activity to show the source country flag from an IP address.
# [operator · bool]  default: true
# example:
#   DEDALO_GEOIP_ENABLED=true
#DEDALO_GEOIP_ENABLED=true

# Directory where the local IP to Country database file is downloaded and
# cached. Defaults to geoip inside the private directory (outside the web
# root).
# [operator · string]  default: `<private dir>/geoip`
# example:
#   DEDALO_GEOIP_DIR="/srv/dedalo/geoip"
#DEDALO_GEOIP_DIR=

# When enabled, the server downloads the IP to Country database on first use
# and refreshes it monthly. Disable it to use only a database file placed
# manually in DEDALO_GEOIP_DIR (e.g. air-gapped installs).
# [operator · bool]  default: true
# example:
#   DEDALO_GEOIP_AUTO_UPDATE=true
#DEDALO_GEOIP_AUTO_UPDATE=true

# Overrides the default monthly DB-IP download URL. Use it to point at a
# mirror or a pinned month. The default is
# https://download.db-ip.com/free/dbip-country-lite-YYYY-MM.mmdb.gz (the
# current month, with a fallback to the previous month), computed
# automatically.
# [operator · string]  default: (unset)
# example:
#   DEDALO_GEOIP_DB_URL="https://mirror.example.org/dbip-country-lite-2026-07.mmdb.gz"
#DEDALO_GEOIP_DB_URL=

# ══════════════════════════════════════════════════════════════════════════════
#  [diffusion]  Diffusion variables
# ══════════════════════════════════════════════════════════════════════════════

# The publication databases served by the legacy publication server API v1
# (publication/server_api/v1), each with the access code that API expects. The
# maintenance dashboard (Publication → Publication server API) shows one "Open
# Swagger UI" button per entry, opening the API's interactive documentation
# for that database with the code, the database name and the current interface
# language already filled in.
# [operator · array of objects]  default: (unset)
# example:
#   API_WEB_USER_CODE_MULTIPLE=[{"db_name":"web_my_entity","code":"my_api_code"}]
#API_WEB_USER_CODE_MULTIPLE=

# The number of records the publication resolver walks per batch. Diffusion is
# a streaming process: records are selected in ordered batches, resolved, and
# handed to the format writer, so that a section of hundreds of thousands of
# records never has to fit in memory at once. A smaller batch lowers the
# memory ceiling of a publication run; a larger one reduces the number of
# round trips to the database.
# [operator · int]  default: (unset)
# example:
#   DEDALO_DIFFUSION_BATCH_RECORDS=500
#DEDALO_DIFFUSION_BATCH_RECORDS=

# The maximum number of rows the engine packs into a single insert/update
# statement when it writes a published table into the target database. Default
# 200.
# [operator · int]  default: 200
# example:
#   DEDALO_DIFFUSION_BATCH_ROWS=200
#DEDALO_DIFFUSION_BATCH_ROWS=200

# This parameter would be set with the diffusion domain of our project
# publication, diffusion domain is the target domain or the part of diffusion
# ontology that will be used to get the tables and fields and the relation
# components in the back-end.
# [operator · string]  default: (unset)
# example:
#   DEDALO_DIFFUSION_DOMAIN="default"
#DEDALO_DIFFUSION_DOMAIN=

# The directory under which the file-format publications (RDF, XML, Markdown,
# CSV, JSON…) are written, one subdirectory per format and publication target.
# When unset — the normal case — Dédalo publishes under its media root (the
# resolved MEDIA_PATH, or the derived default when that key is unset).
# [operator · string]  default: (unset)
# example:
#   DEDALO_DIFFUSION_FILES_ROOT="/var/www/published"
#DEDALO_DIFFUSION_FILES_ROOT=

# How many publication jobs may run at the same time. Dédalo queues every
# diffusion request durably and dispatches it to a runner process of its own —
# a separate, killable process with its own memory ceiling — so a long
# publication survives a browser disconnect, a logout, or a server restart.
# This key caps how many of those processes the scheduler will have in flight;
# further jobs simply wait in the queue. Default 2, minimum 1.
# [operator · int]  default: 2
# example:
#   DEDALO_DIFFUSION_MAX_RUNNERS=2
#DEDALO_DIFFUSION_MAX_RUNNERS=2

# Routes the publication tool to the diffusion engine built into this server
# instead of the separate, external diffusion service of earlier releases. The
# tool in the browser is unchanged, only the server that answers it is.
# [operator · bool]  default: true
# example:
#   DEDALO_DIFFUSION_NATIVE=false
#DEDALO_DIFFUSION_NATIVE=true

# A staged-migration lever: the diffusion element tipos that the native engine
# is allowed to publish, or the single value all for every one of them. An
# element outside the list is refused loudly with an explicit "not routed"
# message, so that one element+section is never published by two engines at
# once.
# [operator · array]  default: (unset)
# example:
#   DEDALO_DIFFUSION_NATIVE_ELEMENTS=["dd1190","rsc167"]
#DEDALO_DIFFUSION_NATIVE_ELEMENTS=

# This parameter set the number of resolution levels we would like to
# accomplish. By default, its value is set to '2'.
# [operator · int]  default: 2
# example:
#   DEDALO_DIFFUSION_RESOLVE_LEVELS=2
#DEDALO_DIFFUSION_RESOLVE_LEVELS=2

# Whether this server claims publication jobs from the queue and dispatches
# runner processes for them. Enabled by default: a standard, single-server
# installation must have it on, or publications will queue and never start.
# [operator · bool]  default: true
# example:
#   DEDALO_DIFFUSION_SCHEDULER_ENABLED=false
#DEDALO_DIFFUSION_SCHEDULER_ENABLED=true

# The address of the publication server API v2 (publication/server_api/v2),
# its BASE_PATH included — the same address a client of the API uses, e.g.
# https://pub.example.org/publication/server_api/v2. The maintenance dashboard
# (Publication → Publication server API) shows one "Open API v2 docs" button
# opening <address>/docs, the API's own interactive documentation (Swagger UI
# and Scalar).
# [operator · string]  default: (unset)
# example:
#   DEDALO_PUBLICATION_API_V2_URL=https://pub.example.org/publication/server_api/v2
#DEDALO_PUBLICATION_API_V2_URL=

# ══════════════════════════════════════════════════════════════════════════════
#  [db]  Work system database variables
# ══════════════════════════════════════════════════════════════════════════════

# This parameter defines the hostname of the server that is running the
# database. By default Dédalo uses localhost, because the database and the web
# server typically run on the same machine — but it is possible to point this
# at a separate database server.
# [operator · string]  default: localhost
# example:
#   DB_HOST="localhost"
DB_HOST=localhost

# This parameter defines the name of the database in PostgreSQL.
# [operator · string]  default: dedalo_install_placeholder
# example:
#   DB_NAME="dedalo_XXX"
DB_NAME=dedalo_mydatabase

# This parameter defines the password of the database user.
# [secret · string]  default: (empty)
# example:
#   DB_PASSWORD="my_password"
DB_PASSWORD=mypassword

# How long (in milliseconds) a request waits for a free database connection
# when the pool is fully in use, before it gives up. The default 0 means wait
# forever.
# [operator · int]  default: 0
# example:
#   DB_POOL_ACQUIRE_TIMEOUT_MS=30000
#DB_POOL_ACQUIRE_TIMEOUT_MS=0

# The maximum number of PostgreSQL connections this process keeps open.
# Default 10, minimum 1.
# [operator · int]  default: 10
# example:
#   DB_POOL_MAX=10
#DB_POOL_MAX=10

# The number of PostgreSQL connections this process keeps for MAINTENANCE work
# — the maintenance-area actions that scale with the size of the data (store
# rebuilds, VACUUM and REINDEX, bulk transforms, imports), the data-update
# engine and the other deliberately long operations. The other
# maintenance-area actions stay on the request pool, so they never queue
# behind a long one. Default 2, minimum 1 (a 0 is read as 1).
# [operator · int]  default: 2
# example:
#   DB_MAINTENANCE_POOL_MAX=2
#DB_MAINTENANCE_POOL_MAX=2

# This parameter defines the host port of the server that is running the
# database. By default Dédalo uses the default PostgreSQL 5432 port.
# [operator · int]  default: 5432
# example:
#   DB_PORT=5432
#DB_PORT=5432

# The unix-socket DIRECTORY of the PostgreSQL server, for a local connection
# that does not go through the network stack (e.g. /var/run/postgresql on
# Debian/Ubuntu, /tmp on macOS Homebrew). When set it wins: DB_HOST is then
# ignored for the connection, and DB_PORT only selects the socket file inside
# the directory (.s.PGSQL.<port>). A path to the socket file itself
# (/var/run/postgresql/.s.PGSQL.5432) is accepted too; its port is the one in
# the file name.
# [operator · string]  default: (empty)
# example:
#   DB_SOCKET="/var/run/postgresql"
#DB_SOCKET=

# Whether the engine negotiates TLS on its PostgreSQL connections, in
# PostgreSQL's own sslmode vocabulary: disable (the default), allow, prefer,
# require, verify-ca or verify-full.
# [operator · string]  default: disable
# example:
#   DB_SSLMODE=disable
#DB_SSLMODE=disable

# The maximum time (in milliseconds) any single database statement of ordinary
# request traffic may run before PostgreSQL cancels it. The default 0 means no
# limit.
# [operator · int]  default: 0
# example:
#   DB_STATEMENT_TIMEOUT_MS=60000
#DB_STATEMENT_TIMEOUT_MS=0

# This parameter defines the name of the user who can administer the database.
# This user must be an administrator or owner of the database, Dédalo must be
# able to create, update and select all tables and records.
# [operator · string]  default: dedalo
# example:
#   DB_USER="my_username"
DB_USER=myusername

# This parameter defines the directory holding the PostgreSQL client binaries
# (psql, pg_dump, pg_restore) used for maintenance tasks and backups. When
# unset, Dédalo probes common Homebrew install locations (newest version
# first) and falls back to resolving the binary name from PATH.
# [operator · string]  default: (unset)
# example:
#   DEDALO_PG_BIN_PATH="/usr/lib/postgresql/16/bin/"
#DEDALO_PG_BIN_PATH=

# From this list offset on, default-ordered section searches are rewritten to
# a "late row lookup": the wanted page of record ids is found on an index-only
# scan first, and only those rows' full data is fetched. Same rows, same order
# — measured ~70× faster at offset 300000 on a 438k-record section, because a
# plain OFFSET makes PostgreSQL read and discard every skipped row's data
# columns.
# [operator · int]  default: 1000
# example:
#   SEARCH_LATE_ROW_LOOKUP_OFFSET=1000
#SEARCH_LATE_ROW_LOOKUP_OFFSET=1000

# The freshness backstop (in milliseconds) for every cached BROWSE TOTAL. It
# was named for the first of them: the unfiltered time-machine browse shows a
# total that costs a full count of the (typically huge, append-only)
# matrix_time_machine table. It now also floors the list assembler's totals —
# the unfiltered per-section browse count (per ACL scope), the
# projects-density verdict and the section-total verdict — each of which is a
# full count of a section's records. All are invalidated on every save this
# engine performs; this key bounds how long one may survive a change made by
# anything else. Default 30000 (30 s). Set 0 to disable the caches and count
# exactly on every request — the right setting for parity test environments.
# [operator · int]  default: 30000
# example:
#   TM_COUNT_CACHE_TTL_MS=30000
#TM_COUNT_CACHE_TTL_MS=30000

# This parameter defines the time limit for query calls: if a statement takes
# longer than this value, Dédalo logs a warning line naming it. Set to 0 (the
# default) to disable slow-query logging.
# [operator · int]  default: 0
# example:
#   DEDALO_SLOW_QUERY_MS=1200
#DEDALO_SLOW_QUERY_MS=0

# ══════════════════════════════════════════════════════════════════════════════
#  [diffusion_db]  Diffusion system database (MariaDB)
# The diffusion system database is the external, flat (publication) copy of
# the data, stored in MariaDB/MySQL: only public data is exported,
# relationships are pre-resolved, and the result is standard SQL
# tables/rows/columns.

Every MariaDB operation — publish, delete, backup — is
# performed by the [diffusion engine](../diffusion/native_engine.md) built
# into the work server.
# ══════════════════════════════════════════════════════════════════════════════

# The hostname or IP of the MariaDB/MySQL server that receives the published
# tables. Set it when the publication target runs on a different machine than
# Dédalo, or when it listens on TCP rather than on a local socket.
# [operator · string]  default: (unset)
# example:
#   DEDALO_DIFFUSION_DB_HOST="localhost"
#DEDALO_DIFFUSION_DB_HOST=

# The password of DEDALO_DIFFUSION_DB_USER, the account Dédalo uses to write
# the published tables into the target database. This is a secret: the shipped
# template carries a placeholder only, and a real installation must replace it
# with the actual password (or leave it empty when the target authenticates
# the user by socket instead).
# [secret · string]  default: (empty)
# example:
#   DEDALO_DIFFUSION_DB_PASSWORD="my_password"
#DEDALO_DIFFUSION_DB_PASSWORD=

# The TCP port of the publication target database. Only used when
# DEDALO_DIFFUSION_DB_HOST is set (a socket connection ignores it). Defaults
# to 3306, the standard MariaDB/MySQL port.
# [operator · int]  default: 3306
# example:
#   DEDALO_DIFFUSION_DB_PORT=3306
#DEDALO_DIFFUSION_DB_PORT=3306

# Path to the local unix socket of the publication target database. Set it
# when the target server runs on the same machine as Dédalo and you want to
# bypass TCP — the usual production posture, and the fastest one.
# [operator · string]  default: (unset)
# example:
#   DEDALO_DIFFUSION_DB_SOCKET="/var/run/mysqld/mysqld.sock"
#DEDALO_DIFFUSION_DB_SOCKET=

# The user account Dédalo connects with to publish into the target database.
# It must be able to create and alter the published tables and to insert,
# update and delete their rows: the engine provisions the table structure from
# the diffusion ontology on every run, so read/write on existing tables is not
# enough.
# [operator · string]  default: (empty)
# example:
#   DEDALO_DIFFUSION_DB_USER="my_username"
#DEDALO_DIFFUSION_DB_USER=

# ══════════════════════════════════════════════════════════════════════════════
#  NOT HONORED
# Settings a v6 install could define that this engine has no consumer for.
# Listed so an upgrade can tell "dropped on purpose" from "forgotten". Setting
# one does nothing.
# ══════════════════════════════════════════════════════════════════════════════
#   BOOTSTRAP_CSS_URL — PHP-only: the TS engine has no such subsystem
#   BOOTSTRAP_JS_URL — PHP-only: the TS engine has no such subsystem
#   COLOR_PROFILES_PATH — derived: the v7 engine computes this path/URL itself
#   CONFIG_DEFAULT_FILE_PATH — derived: the v7 engine computes this path/URL itself
#   D3_URL_JS — PHP-only: the TS engine has no such subsystem
#   DEDALO_3D_COLLADA2GLTF_PATH — PHP-only: the TS engine has no such subsystem
#   DEDALO_3D_FBX2GLTF_PATH — PHP-only: the TS engine has no such subsystem
#   DEDALO_3D_GLTFPACK_PATH — PHP-only: the TS engine has no such subsystem
#   DEDALO_3D_MIME_TYPE — derived: v7 resolves the media type from the file extension
#   DEDALO_3D_THUMB_DEFAULT — superseded inside v6 by the generic DEDALO_QUALITY_THUMB (a SAME key); no v6 or v7 code reads the per-family name
#   DEDALO_6_CODE_FILES_DIR — previous-major code-server pointer: v7 serves ONE major (the live keys are DEDALO_CODE_FILES_DIR / DEDALO_CODE_SERVER_GIT_DIR; DEDALO_SOURCE_VERSION_LOCAL_DIR is declared but not honoured)
#   DEDALO_6_CODE_SERVER_GIT_DIR — previous-major code-server pointer: v7 serves ONE major (the live keys are DEDALO_CODE_FILES_DIR / DEDALO_CODE_SERVER_GIT_DIR; DEDALO_SOURCE_VERSION_LOCAL_DIR is declared but not honoured)
#   DEDALO_6_SOURCE_VERSION_LOCAL_DIR — previous-major code-server pointer: v7 serves ONE major (the live keys are DEDALO_CODE_FILES_DIR / DEDALO_CODE_SERVER_GIT_DIR; DEDALO_SOURCE_VERSION_LOCAL_DIR is declared but not honoured)
#   DEDALO_6_SOURCE_VERSION_URL — previous-major code-server pointer: v7 serves ONE major (the live keys are DEDALO_CODE_FILES_DIR / DEDALO_CODE_SERVER_GIT_DIR; DEDALO_SOURCE_VERSION_LOCAL_DIR is declared but not honoured)
#   DEDALO_ADITIONAL_CSS — PHP-only: the TS engine has no such subsystem
#   DEDALO_API_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_API_URL_UNIT_TEST — PHP-only: the TS engine has no such subsystem
#   DEDALO_AV_BEST_EXTENSIONS — PHP-only: the TS engine has no such subsystem
#   DEDALO_AV_FFMPEG_SETTINGS — PHP-only: the TS engine has no such subsystem
#   DEDALO_AV_MIME_TYPE — derived: v7 resolves the media type from the file extension
#   DEDALO_AV_RECOMPRESS_ALL — PHP-only: the TS engine has no such subsystem
#   DEDALO_AV_STREAMER — PHP-only: the TS engine has no such subsystem
#   DEDALO_AV_TYPE — derived: v7 resolves the media type from the file extension
#   DEDALO_AV_WATERMARK_FILE — PHP-only: the TS engine has no such subsystem
#   DEDALO_BACKUP_ON_LOGIN — PHP-only: the TS engine has no such subsystem
#   DEDALO_BACKUP_PATH_DB — derived: the v7 engine computes this path/URL itself
#   DEDALO_BACKUP_PATH_ONTOLOGY — derived: the v7 engine computes this path/URL itself
#   DEDALO_BACKUP_PATH_STRUCTURE — derived: the v7 engine computes this path/URL itself
#   DEDALO_BACKUP_PATH_TEMP — derived: the v7 engine computes this path/URL itself
#   DEDALO_BACKUP_PATH_USERS — derived: the v7 engine computes this path/URL itself
#   DEDALO_CACHE_MANAGER — PHP-only: the TS engine has no such subsystem
#   DEDALO_CODE_FILES_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_CONFIG — derived: the v7 engine computes this path/URL itself
#   DEDALO_CONFIG_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_CORE — derived: the v7 engine computes this path/URL itself
#   DEDALO_CORE_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_CORE_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_DB_MANAGEMENT — PHP-only: the TS engine has no such subsystem
#   DEDALO_DB_TYPE — PHP-only: the TS engine has no such subsystem
#   DEDALO_DIFFUSION_API_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_DIFFUSION_INTERNAL_TOKEN — no TS consumer (see the "NOT HONORED" block of sample.env)
#   DEDALO_DIFFUSION_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_DIFFUSION_SERVICE_CMD — no TS consumer (see the "NOT HONORED" block of sample.env)
#   DEDALO_DIFFUSION_SOCKET_PATH — no TS consumer (see the "NOT HONORED" block of sample.env)
#   DEDALO_DIFFUSION_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_ENTITY_MEDIA_AREA_TIPO — no TS consumer (see the "NOT HONORED" block of sample.env)
#   DEDALO_EXTRAS_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_EXTRAS_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_FILTER_USER_RECORDS_BY_ID — no v7 key: the row-level record ACL (component_filter_records) is enforced whenever a user has an allow-list, not behind a flag
#   DEDALO_HTML_FILES_EXTENSION — PHP-only: the TS engine has no such subsystem
#   DEDALO_IMAGE_BEST_EXTENSIONS — PHP-only: the TS engine has no such subsystem
#   DEDALO_IMAGE_FILE_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_IMAGE_LIB — PHP-only: the TS engine has no such subsystem
#   DEDALO_IMAGE_MIME_TYPE — derived: v7 resolves the media type from the file extension
#   DEDALO_IMAGE_THUMB_DEFAULT — superseded inside v6 by the generic DEDALO_QUALITY_THUMB (a SAME key); no v6 or v7 code reads the per-family name
#   DEDALO_IMAGE_TYPE — derived: v7 resolves the media type from the file extension
#   DEDALO_INFO_KEY — v6 password-encryption IV seed: not used by Argon2id — see the legacy-password warning
#   DEDALO_INFORMATION — v6 password-encryption key: v7 stores Argon2id hashes (per-password salt embedded) and never decrypts — see the legacy-password warning
#   DEDALO_INSTALL_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_INSTALL_STATUS — runtime state: lives in ../private/ts_state.json, not .env
#   DEDALO_INSTALL_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_LIB — derived: the v7 engine computes this path/URL itself
#   DEDALO_LIB_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_LIB_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_MAINTENANCE_MODE — runtime state: lives in ../private/ts_state.json, not .env
#   DEDALO_MAINTENANCE_MODE_CUSTOM — runtime state: lives in ../private/ts_state.json, not .env
#   DEDALO_MCP_PROXY_URL — PHP-only: the TS engine has no such subsystem
#   DEDALO_MEDIA_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_NODEJS — PHP-only: the TS engine has no such subsystem
#   DEDALO_NODEJS_PM2 — PHP-only: the TS engine has no such subsystem
#   DEDALO_NOTIFICATION — runtime state: lives in ../private/ts_state.json, not .env
#   DEDALO_NOTIFICATION_CUSTOM — runtime state: lives in ../private/ts_state.json, not .env
#   DEDALO_PDF_MIME_TYPE — derived: v7 resolves the media type from the file extension
#   DEDALO_PDF_RENDERER — PHP-only: the TS engine has no such subsystem
#   DEDALO_PDF_THUMB_DEFAULT — superseded inside v6 by the generic DEDALO_QUALITY_THUMB (a SAME key); no v6 or v7 code reads the per-family name
#   DEDALO_PDF_TYPE — derived: v7 resolves the media type from the file extension
#   DEDALO_PERMISSIONS_ROOT — PHP-only: the TS engine has no such subsystem
#   DEDALO_PROFILE_DEFAULT — PHP-only: the TS engine has no such subsystem
#   DEDALO_PUBLICATION_ALERT — no TS consumer (see the "NOT HONORED" block of sample.env)
#   DEDALO_PUBLICATION_CLEAN_URL — no TS consumer (see the "NOT HONORED" block of sample.env)
#   DEDALO_RECOVERY_KEY — PHP-only: the TS engine has no such subsystem
#   DEDALO_RECOVERY_MODE — runtime state: lives in ../private/ts_state.json, not .env
#   DEDALO_ROOT_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_ROOT_WEB — derived: the v7 engine computes this path/URL itself
#   DEDALO_SALT_STRING — v6 session-token seed (never a password salt); v7 manages its own session secrets
#   DEDALO_SECTION_ID_TEMP — no TS consumer (see the "NOT HONORED" block of sample.env)
#   DEDALO_SESSION_HANDLER — PHP-only: the TS engine has no such subsystem
#   DEDALO_SESSION_SAVE_PATH — PHP-only: the TS engine has no such subsystem
#   DEDALO_SESSIONS_PATH — PHP-only: the TS engine has no such subsystem
#   DEDALO_SHARED — derived: the v7 engine computes this path/URL itself
#   DEDALO_SHARED_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_SHARED_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_SOURCE_VERSION_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_STRUCTURE_CSS — PHP-only: the TS engine has no such subsystem
#   DEDALO_SVG_MIME_TYPE — derived: v7 resolves the media type from the file extension
#   DEDALO_TEST_INSTALL — runtime state: lives in ../private/ts_state.json, not .env
#   DEDALO_TOOL_EXPORT_FOLDER_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_TOOL_IMPORT_DEDALO_CSV_FOLDER_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_TOOLS — derived: the v7 engine computes this path/URL itself
#   DEDALO_TOOLS_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_TOOLS_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_TRANSLATOR_URL — PHP-only: the TS engine has no such subsystem
#   DEDALO_UPLOAD_TMP_DIR — derived: the v7 engine computes this path/URL itself
#   DEDALO_UPLOAD_TMP_URL — derived: the v7 engine computes this path/URL itself
#   DEDALO_WIDGETS_PATH — derived: the v7 engine computes this path/URL itself
#   DEDALO_WIDGETS_URL — derived: the v7 engine computes this path/URL itself
#   DEVELOPMENT_SERVER — in v7 the client DEVELOPMENT_SERVER flag is derived from DEDALO_DEV_MODE
#   DIFFUSION_CUSTOM — no TS consumer (see the "NOT HONORED" block of sample.env)
#   ENCRYPTION_MODE — PHP-only: the TS engine has no such subsystem
#   EXCLUDE_DIFFUSION_ELEMENTS — no TS consumer (see the "NOT HONORED" block of sample.env)
#   EXPORT_HIERARCHY_PATH — derived: the v7 engine computes this path/URL itself
#   GEONAMES_ACCOUNT_USERNAME — PHP-only: the TS engine has no such subsystem
#   IP_API — superseded: IP→country resolves server-side via the native GeoIP subsystem (src/core/geoip), not a client-side API descriptor
#   JQUERY_LIB_URL_JS — PHP-only: the TS engine has no such subsystem
#   JQUERY_TABLESORTER_JS — PHP-only: the TS engine has no such subsystem
#   JQUERY_UI_URL_CSS — PHP-only: the TS engine has no such subsystem
#   JQUERY_UI_URL_JS — PHP-only: the TS engine has no such subsystem
#   LEAFLET_JS_URL — PHP-only: the TS engine has no such subsystem
#   LOGGER_LEVEL — PHP-only: the TS engine has no such subsystem
#   MAGICK_CONFIG — PHP-only: the TS engine has no such subsystem
#   MYSQL_DB_BIN_PATH — PHP-only: the TS engine has no such subsystem
#   MYSQL_DEDALO_DATABASE_CONN — v7 resolves the diffusion target database per publication, not from config
#   NUMERICAL_MATRIX_VALUE_NO — no TS consumer (see the "NOT HONORED" block of sample.env)
#   NUMERICAL_MATRIX_VALUE_YES — no TS consumer (see the "NOT HONORED" block of sample.env)
#   NVD3_URL_CSS — PHP-only: the TS engine has no such subsystem
#   NVD3_URL_JS — PHP-only: the TS engine has no such subsystem
#   ONTOLOGY_DATA_IO_URL — derived: the v7 engine computes this path/URL itself
#   ONTOLOGY_DOWNLOAD_DIR — derived: the v7 engine computes this path/URL itself
#   PAPER_JS_URL — PHP-only: the TS engine has no such subsystem
#   PERSISTENT_CONNECTION — PHP pg_pconnect switch: the TS engine always holds a pooled Bun.sql connection set — size it with DB_POOL_MAX / DB_POOL_ACQUIRE_TIMEOUT_MS
#   PHP_BIN_PATH — PHP-only: the TS engine has no such subsystem
#   SERVER_PROXY — no Dédalo key in v7: set the standard HTTPS_PROXY / HTTP_PROXY in the server environment instead (Bun fetch honors them)
#   SHOW_DEBUG — per-user in v6 (superuser only); in v7 the client SHOW_DEBUG flag is derived the same way (superuser), NOT from config
#   SHOW_DEVELOPER — per-user in v6 (the is_developer DB flag); in v7 the client SHOW_DEVELOPER flag is derived the same way (is_developer), NOT from config
#   STRUCTURE_DOWNLOAD_JSON_FILE — derived: the v7 engine computes this path/URL itself
#   STRUCTURE_IS_MASTER — v6 flag that only toggled an export button in the PHP ontology list; the v7 ontology-master role is IS_AN_ONTOLOGY_SERVER
#   STRUCTURE_SERVER_CODE — no TS consumer (see the "NOT HONORED" block of sample.env)
#   STRUCTURE_SERVER_CODE_OTHERS — no TS consumer (see the "NOT HONORED" block of sample.env)
#   STRUCTURE_SERVER_URL — no TS consumer (see the "NOT HONORED" block of sample.env)
#   TEXT_EDITOR_URL_JS — PHP-only: the TS engine has no such subsystem
#   TEXT_SUBTITLES_ENGINE — PHP-only: the TS engine has no such subsystem
#   USE_CDN — PHP-only: the TS engine has no such subsystem
