# Dédalo TS server — reference systemd unit (audit S2-38, DEC-17 item 3).
#
# THREE PLACEHOLDERS, one rule (the layout is defined by ROLE, not by a path —
# engineering/PRODUCTION.md §2.2, docs/install/manual_host.md renders them):
#   DEDALO_USER    the service user
#   INSTANCE_DIR   the instance directory, OWNED BY DEDALO_USER: the code
#                  (INSTANCE_DIR/master_dedalo, the WorkingDirectory), ../private
#                  and backups/ — a code update renames the tree INSIDE it, so its
#                  parent may stay root-owned (/home/my_domain.org/dedalo,
#                  /opt/dedalo/app)
#   ROOT_BIN_DIR   ROOT-OWNED, outside INSTANCE_DIR: the PINNED runtime
#                  (ROOT_BIN_DIR/bun) and every script a root-started unit runs
#                  (/opt/dedalo/bin, /usr/local/lib/dedalo/<name>/bin)
#
#   sudo systemctl daemon-reload && sudo systemctl enable --now dedalo-ts
#
# The health watchdog (dedalo-ts-watchdog.timer: curls /health over the unix
# socket and restarts/rolls back on failure) comes WITH this unit — Wants= and
# [Install] Also= below — so the two commands above enable it too. systemd's
# native WatchdogSec requires sd_notify, which Bun does not speak; the curl timer
# is the equivalent.

[Unit]
Description=Dedalo TS server (Bun)
After=network.target postgresql.service
Wants=postgresql.service
# THE HEALTH CONSUMER IS PART OF THE UNIT, NOT OF THE RUNBOOK (P2-33 / OPS-09).
# systemd's native WatchdogSec needs sd_notify, which Bun does not speak; the
# equivalent here is the curl timer, which polls /health every 30 s and escalates
# to dedalo-ts-restart.service or dedalo-ts-rollback.service. It used to be
# enabled only by a hand-typed `systemctl enable --now dedalo-ts-watchdog.timer`,
# so an operator who followed the two-line install at the top of this file got a
# server with NO consumer for its own 503 — the same hole the compose stacks had.
# Wants= pulls the timer in with the server; [Install] Also= enables it with it.
Wants=dedalo-ts-watchdog.timer

# Crash-loop budget. systemd's DEFAULT is 5 starts per 10 s, after which the unit
# is left in `failed` and NOTHING restarts it — with RestartSec=3 that ceiling sits
# right on top of a normal restart cadence, so a burst of planned restarts (an
# installer persisting config, a code update) or a transient dependency outage
# (Postgres slow to accept) can wedge the service permanently. Widened to 5 starts
# per 5 min: still a real backstop against a hot crash loop, but no longer trippable
# by legitimate restarts.
StartLimitIntervalSec=300
StartLimitBurst=5

# Code-update rollback hook. The unit enters `failed` in exactly two ways: the
# start limit above is exhausted — precisely the "the newly swapped-in code tree
# never boots" signature (Restart=always keeps retrying individual crashes as
# before) — or ONE exit 78 (RestartPreventExitStatus below: the server refused to
# boot, not installed for this environment). Both land here: with a pending
# update, a new tree that refuses to boot is rolled back after a single exit. The rollback unit is a
# no-op unless the code-update sentinel (<backup root>/last_code_update.json)
# says a pending, unconfirmed update exists — so an ordinary crash loop with no
# update in flight fires it harmlessly and nothing is touched. See
# deploy/dedalo-code-rollback.sh.
OnFailure=dedalo-ts-rollback.service

[Service]
Type=simple
# User= and Group= are TWO values. This guide's layout makes them the same string
# (adduser --system --group dedalo), so only one placeholder appears — but on a host
# upgraded from an older install the service user often has the WEB SERVER's group as
# its primary group and no group of its own. Group= must name a group that EXISTS
# (getent group <name>), or systemd fails the unit with "Failed to determine group
# credentials: No such process" before Bun ever runs. Omitted here = the user's
# primary group, which is also what UMask=0007 below makes the socket group-owned by.
User=DEDALO_USER
WorkingDirectory=INSTANCE_DIR/master_dedalo
# The runtime is PINNED (.bun-version / package.json engines.bun) — point
# ExecStart at the pinned binary, not a floating `bun` on PATH, so a stray
# `bun upgrade` cannot change the production runtime (audit S2-36).
ExecStart=ROOT_BIN_DIR/bun run src/server.ts

# Socket directory (the "socket never appears / 502" trap). The server binds
# SERVER_UNIX_SOCKET but does NOT create its parent dir. RuntimeDirectory=dedalo
# makes systemd create /run/dedalo (owned by this service's User) on every start
# and remove it on stop — so SERVER_UNIX_SOCKET must live under /run/dedalo/
# (canonical: /run/dedalo/dedalo_ts.sock). /run is tmpfs, wiped each reboot; a
# hand-made mkdir would not survive, which is exactly why this is here.
RuntimeDirectory=dedalo
RuntimeDirectoryMode=0750

# Socket permissions (the 502-on-every-request trap). The server creates
# SERVER_UNIX_SOCKET under the process umask; the default 022 yields srwxr-xr-x, and
# CONNECTING to a unix socket requires WRITE permission — so a reverse proxy running as
# www-data/nginx gets EACCES and every request 502s, with nothing wrong in the app.
# UMask=0007 makes it srwxrwx---; add the web-server user to the `dedalo` group:
#     sudo usermod -aG dedalo www-data      # or: nginx
UMask=0007
# No EnvironmentFile here on purpose: the server reads ../private/.env
# ITSELF (src/config/env.ts readEnv/parseEnvFile), so pointing systemd's
# EnvironmentFile= at the same file is redundant — and actively harmful,
# because systemd's EnvironmentFile parser quotes/escapes differently from
# parseEnvFile and mangles raw-JSON values such as
# DEDALO_APPLICATION_LANGS={"lg-spa":"Castellano"} (the embedded unescaped
# quotes are not valid systemd env-file syntax). If a systemd-level override
# is genuinely needed, use `systemctl edit dedalo-ts` to add a drop-in
# Environment=/EnvironmentFile= instead of editing this unit.

# Supervision (audit S2-38): any crash — OOM, native fault, unhandled error —
# restarts the server after 3 s. The server's own SIGTERM handler drains
# in-flight requests, closes the DB pool and unlinks the socket (S2-17).
Restart=always
RestartSec=3
# Exit 75 (RESTART_EXIT_CODE, src/core/update/restart.ts) is a PLANNED restart:
# a code update / code restore swapped the tree and needs the new code booted.
# Restart=always is what brings it back (under Restart=on-failure this line
# would PREVENT that restart); this line just keeps the planned exit out of the
# failure counters (and out of the watchdog's alerting), instead of logging it
# as a crash.
SuccessExitStatus=75
# Exit 78 (NOT_INSTALLED_EXIT_CODE, src/config/install_state.ts — EX_CONFIG) is
# a REFUSAL: no configuration, a sealed install whose .env is gone, or an
# unfinished install. Restarting cannot fix any of them, so the unit goes to
# `failed` and STAYS there with the one "[boot] REFUSED — …" journal line;
# dedalo-ts-watchdog.sh honours the same code. Run the installer (or restore
# .env), then `systemctl start`.
RestartPreventExitStatus=78
# Supervision is DECLARED here, by the thing that restarts the process — never in
# ../private/.env, which every launch method reads (an unsupervised `bun run start`
# included) and the engine therefore ignores for this key. A code update swaps the
# tree and exits; it refuses unless this line says systemd will bring it back
# (src/core/update/supervision.ts).
Environment=DEDALO_SUPERVISED=true
TimeoutStopSec=30
KillSignal=SIGTERM
# Signal the SERVER only, never its children. Diffusion dispatches one runner
# process per job (src/diffusion/jobs/scheduler.ts) and those runners are designed
# to SURVIVE a server restart: they talk only to Postgres, finish their job, and
# the sweeper heals whatever does not. Under systemd's default
# (KillMode=control-group) every runner is signalled and then SIGKILLed with the
# server, silently truncating long publications mid-flight and making
# engineering/PRODUCTION.md's "runners survive by design" false. The cost of
# `process` is the honest tradeoff: a wedged runner is no longer reaped by the
# unit stop, and is left to the stale-heartbeat sweep + attempt budget.
KillMode=process

# SANDBOX BASELINE (T1-26 / S15). Path-independent: none of these depends on where
# the instance, its media or its backups live, so the same block holds on every
# host (deploy/systemd/dedalo-ts@.service carries it byte-for-byte; gate:
# install_host_render_tripwire). Each was checked against what the engine and the
# tools it spawns do (media converters, OCR, pg_dump/psql, mariadb, git, tar,
# bun install for a code update) — none needs a privilege these remove.
# No setuid/setgid escalation, by the engine or anything it runs; no capabilities.
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
# No personality switch, no realtime scheduling, no new namespaces.
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
# The kernel's tunables, modules, log, control groups, clock and hostname are
# read-only or out of reach.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# A minimal /dev (null, zero, random, urandom, tty, shm): no physical device.
PrivateDevices=yes
# Other users' processes are invisible in /proc.
ProtectProc=invisible
# Native syscalls only; sockets: unix (the socket, Postgres), IP (ontology
# masters, harvest, mail, MariaDB over TCP), netlink (interface enumeration).
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# The file system is READ-ONLY (owner ruling C32, 2026-11-13) except the roots
# below — the paths the engine writes: INSTANCE_DIR (the tree, ../private with
# the sessions and the state file, backups/), the media root and the published
# client (edit /srv/dedalo to your MEDIA_PATH's and DEDALO_CLIENT_PUBLISH_DIR's
# root when they live elsewhere), the Postgres socket dir (a unix connect works
# on a read-only mount, the dir is listed so a DB_SOCKET under another path is a
# visible edit here), and the temp dirs (uploads, PDF extraction, RAG scratch).
# RuntimeDirectory (the engine's socket) is writable by systemd's own rule. Each
# path quoted (campaign 2 L8). The installer's per-instance units derive this list
# from the answers (host/systemd/render.ts writableRoots) and the engine checks
# its configured paths against it at boot; here it is yours to keep true.
ProtectSystem=strict
ReadWritePaths="INSTANCE_DIR"
ReadWritePaths="/srv/dedalo"
ReadWritePaths="/var/run/postgresql"
ReadWritePaths="/tmp"
ReadWritePaths="/var/tmp"
# Deliberately NOT in the baseline:
#   MemoryDenyWriteExecute  Bun's JavaScriptCore JIT writes executable memory.
#   ProcSubset=pid          the maintenance system-info widget reads /proc/cpuinfo.
#   PrivateTmp              diffusion runners (KillMode=process) survive a restart
#                           and work in the temp dir; systemd removes a private
#                           /tmp at stop, under them. Pending a host measurement.
#   ProtectHome             the instance directory may sit under /home.
#   SystemCallFilter        pending a measured syscall set per supported OS.
#   network restrictions    the engine is a network client (see above).

# Log capture (audit S2-37): stdout/stderr → journald. The structured access
# log (DEDALO_ACCESS_LOG=true) emits one JSON line per request here.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dedalo-ts

# Resource hygiene (tune to the host; the server is one shared process).
LimitNOFILE=65536
# MemoryMax=4G

[Install]
WantedBy=multi-user.target
# `systemctl enable dedalo-ts` enables the health watchdog too — see Wants= above.
Also=dedalo-ts-watchdog.timer
