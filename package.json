{
	"name": "dedalo-server-ts",
	"description": "Dédalo server — greenfield native TypeScript rewrite on Bun. Spec: engineering/REWRITE_SPEC.md",
	"version": "0.0.1",
	"module": "src/server.ts",
	"type": "module",
	"private": true,
	"license": "AGPL-3.0-only",
	"engines": {
		"bun": "1.4.3"
	},
	"scripts": {
		"start": "bun run src/server.ts",
		"start:supervised": "while true; do DEDALO_SUPERVISED=true bun run src/server.ts; code=$?; [ $code -eq 75 ] || exit $code; echo '[supervisor] restart requested (exit 75, code update) — rebooting'; done",
		"dev": "DEDALO_SUPERVISED=true bun run scripts/dev.ts",
		"dev:server": "while true; do DEDALO_SUPERVISED=true bun run --watch src/server.ts; code=$?; [ $code -eq 75 ] || exit $code; echo '[supervisor] restart requested (exit 75, code update) — rebooting'; done",
		"css:build": "bun run scripts/build_css.ts",
		"css:watch": "bun run scripts/build_css.ts --watch",
		"css:check": "bun run scripts/build_css.ts --check",
		"css:tool-colors": "bun run scripts/tool_colors.ts",
		"docs:serve": "${npm_config_venv:-.venv}/bin/mkdocs serve",
		"docs:build": "DISABLE_MKDOCS_2_WARNING=true ${npm_config_venv:-.venv}/bin/mkdocs build --strict",
		"docs:setup": "python3 -m venv .venv && .venv/bin/pip install -r docs/requirements.txt",
		"docs:publish": "bun run scripts/docs_publish.ts",
		"changelog": "bun run scripts/changelog.ts",
		"config:gen": "bun run scripts/gen_config_docs.ts",
		"config:check": "bun run scripts/gen_config_docs.ts --check",
		"libs:gen": "bun run scripts/gen_client_lib_docs.ts",
		"libs:check": "bun run scripts/gen_client_lib_docs.ts --check",
		"context:gen": "bun run deploy/build_context.ts",
		"context:check": "bun run deploy/build_context.ts --check",
		"registries:gen": "bun run scripts/image_registries.ts",
		"registries:check": "bun run scripts/image_registries.ts --check",
		"dedalo:install": "bun run scripts/install.ts",
		"dedalo:migrate-config": "bun run scripts/migrate_v6_config.ts",
		"dedalo:migrate-passwords": "bun run scripts/migrate_v6_passwords.ts",
		"dedalo:restore": "bun run scripts/restore.ts",
		"dedalo:pair-publication-host": "bun run scripts/publication_host_pair.ts",
		"test": "bun test --timeout=30000",
		"lint:browser": "bun run scripts/lint_browser_budget.ts",
		"ci:local": "bun run scripts/ci_local.ts",
		"ci:image:pin": "bun run scripts/ci_image_pin.ts",
		"ci:cosign:pin": "bun run scripts/ci_cosign_pin.ts",
		"baselines:bank": "bun run scripts/baselines_bank.ts",
		"push": "bun run scripts/push.ts",
		"prepare": "[ -z \"$CI\" ] && [ -z \"$DEDALO_CI_IMAGE\" ] && [ -f scripts/hooks/pre-push ] && [ \"$(git rev-parse --is-inside-work-tree 2>/dev/null)\" = true ] && [ -z \"$(git rev-parse --show-prefix 2>/dev/null)\" ] && { cur=\"$(git config --get core.hooksPath)\"; if [ -z \"$cur\" ]; then git config core.hooksPath scripts/hooks && echo 'prepare: pre-push gate installed (core.hooksPath=scripts/hooks)'; elif [ \"$cur\" != scripts/hooks ]; then echo \"prepare: core.hooksPath is '$cur', not scripts/hooks: the pre-push gate is NOT active\" >&2; fi; } || true",
		"test:db:setup": "bun run scripts/test_db_setup.ts",
		"seed:build": "bun run scripts/seed_build.ts",
		"test:baseline": "bun run scripts/test_baseline.ts",
		"test:timings": "bun run scripts/test_baseline.ts --timings",
		"test:shard": "bun run scripts/test_shard.ts",
		"test:shard:sweep": "bun run scripts/test_shard.ts --sweep",
		"test:client": "bun run scripts/client_test_runner.ts",
		"test:client:server": "bun run scripts/client_test_serve.ts",
		"test:tools:phone": "bun run scripts/tool_viewport_check.ts",
		"test:update": "bun run scripts/update_drill.ts",
		"test:update:dev": "bun run scripts/update_drill.ts --dev",
		"probe:update": "bun run scripts/update_probe.ts",
		"publication:install": "cd publication/server_api/v2 && bun install",
		"start:publication": "cd publication/server_api/v2 && bun run start",
		"media:publication-host-rules": "bun run scripts/media_publication_host_rules.ts",
		"test:media:pubhost": "bun run scripts/media_publication_host_drill.ts",
		"test:pubhost:probe": "bun run scripts/publication_host_probe_drill.ts",
		"test:pubhost:agent": "bun run scripts/publication_host_agent_drill.ts",
		"test:pubhost:engine": "bun run scripts/publication_host_engine_drill.ts",
		"test:pubhost:init": "bun run scripts/publication_host_init_drill.ts",
		"test:pubhost:init:el": "bun run scripts/publication_host_init_drill.ts --family el --in-place",
		"drill:install-host": "bun run scripts/install_host_drill.ts",
		"test:publication": "cd publication/server_api/v2 && bunx tsc --noEmit && bun test",
		"sitebuilder:install": "cd publication/site_builder && bun install",
		"start:sitebuilder": "cd publication/site_builder && bun run start",
		"test:sitebuilder": "cd publication/site_builder && bunx tsc --noEmit && bun test",
		"sitebuilder:provision": "cd publication/site_builder && bun run src/provision/cli.ts",
		"hostagent:install": "cd publication/host_agent && bun install --frozen-lockfile --production",
		"hostagent:install:dev": "cd publication/host_agent && bun install --frozen-lockfile",
		"hostagent:start": "cd publication/host_agent && bun run src/index.ts",
		"hostagent:test": "cd publication/host_agent && bunx tsc --noEmit && bun test",
		"hostagent:provision": "cd publication/host_agent && bun run src/provision/cli.ts",
		"hostagent:pack": "bun run scripts/publication_host_pack.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.131.0",
		"@geoman-io/leaflet-geoman-free": "2.20.2",
		"@highlightjs/cdn-assets": "11.12.0",
		"@jaames/iro": "5.5.2",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@opentui/core": "0.6.1",
		"@svgedit/svgcanvas": "7.4.2",
		"@turf/turf": "7.4.0",
		"cheerio": "1.2.0",
		"codex-tooltip": "1.0.6",
		"easyqrcodejs": "4.6.2",
		"d3": "7.9.0",
		"flatpickr": "4.6.13",
		"leaflet": "1.9.4",
		"mmdb-lib": "3.0.3",
		"nodemailer": "^10.0.15",
		"onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
		"split.js": "1.6.5",
		"three": "0.186.1",
		"vanilla-jsoneditor": "3.13.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@babel/parser": "8.0.7",
		"@biomejs/biome": "2.5.15",
		"@types/bun": "^1.4.3",
		"@types/less": "3.0.8",
		"axe-core": "^4.14.0",
		"chai": "6.3.0",
		"htmlparser2": "12.0.0",
		"less": "4.9.1",
		"mocha": "12.0.3",
		"parse5": "8.0.1",
		"puppeteer": "^25.13.0"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"overrides": {
		"devalue": "^5.9.1",
		"@hono/node-server": "^2.1.1",
		"brace-expansion": "^2.1.4",
		"fast-uri": "^3.1.8",
		"hono": "^4.13.8",
		"ip-address": "^10.7.2",
		"js-yaml": "^4.3.2"
	}
}
