# Dependencies
node_modules/

# OS noise
.DS_Store

# special hidden
acc/
docs/superpowers/

# Documentation site build output (mkdocs.yml `site_dir`) + Material's asset cache.
# The SOURCE is docs/; the built site is never committed.
docs_site/
.cache/

# Throwaway parity/debug probes. They live at the repo ROOT on purpose — that is what
# lets them import `./src/...` with RELATIVE specifiers (a probe in an out-of-tree
# scratchpad cannot, which is how absolute machine paths crept into the skill docs).
# See .agents/skills/dedalo-parity-debugging/SKILL.md.
probe_*.ts

# Never commit secrets (config lives in ../private/, outside the repo)
.env
# Compose variable substitution for the simple stack, written by install.sh.
# Deliberately NOT named .env: the engine's own loader reads a repo-root .env
# from the container's working directory, which would collide with compose's.
.dedalo.env
# The image updater's interrupted-update marker (deploy/dedalo-image-update.sh, U-20).
.dedalo-image-update.pin
# The docker/trial host steps' run record (plan + state, the terminal installer —
# src/core/install/host/host_executor.ts). Install metadata of THIS host.
/.dedalo-install/

# TLS material and the nginx config install.sh generates from
# deploy/nginx.simple-tls.conf.tpl. PRIVATE KEYS live here — never commit them.
# The template and the plain-HTTP config ARE committed.
/deploy/certs/
/deploy/nginx.simple.generated.conf
# What the terminal installer writes for the docker/trial routes (host/stack/files.ts):
# the full stack's site and its compose override. Machine state, never source.
/deploy/nginx.docker.generated.conf
/compose.override.yaml

# Media root. DEDALO_MEDIA_PATH derives to <repo>/media (PHP parity:
# DEDALO_ROOT_PATH . '/media'), so a running install writes user uploads HERE
# unless MEDIA_PATH points elsewhere. It is data, never source.
/media/

# Client libraries: nothing to ignore, and that is the point. They come from
# `bun install` (node_modules/, already ignored above) or they are COMMITTED under
# vendor/ — ckeditor, json-view, pdfjs, xlsx. There is no install-time fetch step and
# no generated lib directory, so a clone is self-contained. The committed trees are
# digest-pinned in vendor/vendor_manifest.json (nothing else hashes those bytes), so
# an ignore rule here would silently un-pin them.
# Index of record: src/core/client_libs/registry.ts.
# The one scratch path a vendor bump uses: scripts/vendor_fetch.ts downloads and
# extracts OUTSIDE vendor/ so a refused sha256 can never leave a half-written tree
# where the verifier expects a vendored lib. It cleans up; this covers a crash.
/.vendor_fetch_tmp/

# Agent tooling. `.agents/` is the real home (skills + workflows ARE versioned);
# `.claude` is a committed symlink alias to it, so Claude Code keeps working.
# Machine-local state below is never versioned. Git does not descend into the
# symlink, so these must name the REAL path — `.claude/...` rules would be dead.
.agents/settings.local.json
.agents/scheduled_tasks.lock
# Tool-synced third-party skill bucket (docx/pdf/pptx…): machine-local, never the project's.
.agents/skills/synced/
.clinerules

# Local-only foundation audits (security analysis etc.) — not version-controlled
audits/
.claude_migration_component_alias_preimage.json
rewrite/

# Publication API (the isolated read-only subsystem under publication/).
# v1: the deployer copies config_api/sample.server_config_api.php to this name and
# fills in the published-DB credentials + the shared `code` — real secrets, never committed.
server_config_api.php
# v2: TypeScript incremental-build artifact (its tsconfig sets `incremental: true`).
*.tsbuildinfo

# CSS SOURCE MAPS — build output, never committed (2026-08-01).
# The compiled `.css` IS committed (deploy is a checkout, production has no LESS
# compiler — see .gitattributes), but the `.css.map` is a DEBUG aid only: nothing
# serves worse without it and `bun run css:build` regenerates it. Committed, it was
# pure friction: every token change rewrote 45 machine-generated JSON blobs, so two
# developers touching any .less conflicted on files nobody reads or merges.
# On a fresh checkout devtools 404s on the map until someone runs `bun run css:build`.
# `css_build_tripwire` therefore checks maps FRESHLY BUILT (relative + resolvable
# sources), not on disk; `css:check` compares only the .css bytes.
*.css.map
# (The swagger-ui maps under publication/ used to be un-ignored here. Since P2-5-residue
# the trimmed swagger-ui-dist tree ships NO maps — vendor/vendor_manifest.json row
# "swagger-ui" — so there is nothing to un-ignore.)

# Logs and changelog
*.log
CHANGELOG.md

# Generated by scripts/update_probe.ts (machine-specific bind-mount override)
/docker-compose.update-probe.yml

# Release archives cut by scripts/update_probe.ts (machine-local, ~180MB each)
/code/

# The install stamp the code updater writes INTO an installed tree
# (src/core/update/install_stamp.ts): per-install provenance, never source.
# It must stay untracked so `git archive` can never ship one master's stamp
# inside another install's release.
src/core/update/install_stamp.json
# The Publication API manifest the code updater writes beside the stamp
# (src/core/update/publication_manifest.ts): per-install, never source.
src/core/update/publication_manifest.json

# Scratch media roots a test gate creates in the repo root. `.dedalo_test_media` is the
# marker that ARMS the media-root refusal, so these appear whenever a gate builds its own
# scratch root here; one was committed by accident, which put it in the Docker build
# context's allowlist.
.scratch_*/

# Development tools
.vscode/
dev/
dev_tools/

# old ontology default path used to generate ontology and recovery files (deprecated)
# new default path is out of the dedalo folder: /srv/dedalo/ontology
# EXCEPT the vendored 7.0 seeds (*.copy.gz): tracked, shipped in the image and
# served by the engine. Their recovery output stays ignored.
install/import/ontology/*
!install/import/ontology/7.0/
install/import/ontology/*/recovery/

# The install seed compiler's in-flight files (src/core/install/seed_build.ts):
# the dump and its manifest are written as `.part` and renamed only on success,
# so a crashed compile can leave one behind — never a source, never committed.
install/db/*.part

# Durable hermetic-tier logs (scripts/ci/hermetic.sh HERMETIC_LOG_DIR; ci:local --docker copies
# them here too). Run output, never source.
/ci-logs/
