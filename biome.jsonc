// Biome config (JSONC so rule decisions can carry their justification inline).
{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	// MARKDOWN AND YAML: LINTED, NOT REFORMATTED (biome 2.6, 2026-10-24).
	// 2.6.0 turned the formatter on for both languages by default: 701 .md + 9 .yml
	// files went red with nothing in them changed. Up to 2.5.15 biome read neither, so
	// switching the FORMATTER off keeps the pre-upgrade scope exactly — it narrows
	// nothing that was measured before, and the 2.6 linters for both stay ON.
	// Why not adopt the reformat:
	//   - markdown here is hand-authored prose (docs/ is excluded for the same reason)
	//     and much of it is MACHINE-READ: engineering/TRIPWIRES.md (verify.ts must equal
	//     it), the engineering/wire_contract/ entries, the changes/ fragments that
	//     render docs/change_log.md. A formatter three days old must not rewrite
	//     contract bytes as a side effect of a dev-dependency bump;
	//   - the YAML formatter re-indents aligned trailing comments into a different
	//     reading (.github/codeql/codeql-config.yml's two-line comment becomes a
	//     comment under the list item) and requotes every workflow — the files the
	//     ci_workflow_tripwire and Dependabot both read textually.
	// Adopting either is a deliberate, reviewed pass of its own, not a lockfile bump.
	"markdown": { "formatter": { "enabled": false } },
	"yaml": { "formatter": { "enabled": false } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			// Both DECLARED EXPLICITLY for the same reason as performance/noDelete below:
			// biome 2 dropped them from `recommended`, and a rule this repo suppresses at a
			// named site with a named reason is a rule it relies on — inheriting it from a
			// preset means it can switch off in a minor upgrade with nothing to notice.
			"style": {
				"noParameterAssign": "error"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noVar": "error",
				// OFF (biome 2 added it to `recommended`, 2026-08-03). The rule assumes a
				// `${...}` inside a quoted string is a template literal someone forgot to
				// backtick. In this codebase `${...}` is LITERAL SYNTAX in three domains, and
				// every one of the 22 sites is one of them:
				//   - diffusion placeholder tokens ('${section_tipo}' — a wildcard the
				//     resolver matches on, not an interpolation);
				//   - the GENERATED Apache/nginx rules ('pub/${dd_s}_${dd_i}' — those are the
				//     WEB SERVER's variables, and interpolating them here would break the rule);
				//   - operator-facing prose that documents .env grammar ("No ${VAR} interpolation").
				// Backticking any of them would corrupt the value. A rule that is wrong on
				// 100% of its hits is noise, and noise is what makes a real hit invisible.
				"noTemplateCurlyInString": "off"
			},
			// performance/noDelete stays ON: accidental `delete` is worth catching. The
			// intentional sites (PHP unset() wire-shape parity, process.env unsetting)
			// carry inline biome-ignore comments with reasons — the established repo convention.
			//
			// DECLARED EXPLICITLY since the biome 2 upgrade (2026-08-03): v2 dropped this
			// rule from `recommended`, which turned all 53 of those documented suppressions
			// into dead comments overnight — the rule stopped running and nothing said so.
			// A rule this repo relies on is named here, not inherited from a preset that
			// can quietly change under it.
			"performance": {
				"noDelete": "error"
			}
		}
	},
	"overrides": [
		{
			// SVG IMAGE ASSETS ARE NOT A STYLESHEET (2026-08-31, biome 2.5.11).
			// 2.5.11 began reading the `style="…"` ATTRIBUTE inside .svg files as CSS
			// and applying `noUnknownProperty` to it. That found 114 new errors across
			// the logo and icon set — every one of them `enable-background`, which is
			// a deprecated SVG 1.1 filter property that Adobe Illustrator writes into
			// every file it exports. It is an artifact of the drawing tool, in an image,
			// and nothing in this repo authors or reads it.
			//
			// ONLY THIS RULE, and only here. Excluding `**/*.svg` outright would have
			// been a SCOPE NARROWING — svg already carried 159 real errors under 2.5.6
			// (a11y/noSvgWithoutTitle and friends), and dropping those to make a number
			// fall is exactly what the browser budget's shrink-only ratchet exists to
			// prevent. Every other rule still measures these files.
			"includes": ["**/*.svg"],
			"linter": { "rules": { "correctness": { "noUnknownProperty": "off" } } }
		},
		{
			// Tests assert presence with expect(...).not.toBeNull()/toBeDefined() before
			// using `!`; duplicating runtime guards at ~200 gate sites adds noise without
			// safety. Production code (src/, tools/*/server) must still narrow properly.
			"includes": ["**/test/**"],
			"linter": {
				"rules": {
					"style": { "noNonNullAssertion": "off" },
					// Same argument, for the rule biome 2 added to `recommended` (2026-08-03):
					// `(record?.columns.relation as X).test218` throws a TypeError if the read
					// returned undefined — which in a GATE is the test failing, loudly, at the
					// exact line that made the wrong assumption. All 55 sites are assertions on
					// a value the test has already proven present; rewriting them into guards
					// would turn one honest failure into two lines of ceremony each. In src/
					// the rule stays ON, where an unexpected undefined is a 500, not a red test.
					"correctness": { "noUnsafeOptionalChaining": "off" }
				}
			}
		}
	],
	"files": {
		"includes": [
			"**",

			// EVERY "!" ENTRY BELOW CARRIES ITS REASON. The linter only sees what this
			// list lets it see, so an unexplained exclusion silently retires a whole
			// subsystem from static analysis while `bun run lint` stays green. Gate:
			// test/unit/lint_scope_tripwire.test.ts.

			// NOT OURS, NOT EDITED HERE: installed dependencies and vendored
			// third-party libraries. Linting them reports findings nobody in this
			// repo can act on, and formatting them would fight their upstream.
			"!**/node_modules",
			"!**/vendor",
			"!**/tools/tool_lang/translators/browser_transformer",
			"!**/tools/tool_transcription/transcribers/browser_whisper",
			"!**/tools/**/*/transcribers/lib/**/*.js",

			// TOOLING AND EDITOR STATE, not source: agent config (.agents, with
			// .claude its committed symlink alias), editor settings, the local
			// python venv.
			"!**/.agents",
			"!**/.claude",
			"!**/.vscode",
			"!**/.venv",

			// GENERATED OUTPUT, never hand-edited: the built mkdocs site (untracked).
			"!**/docs_site",

			// LOCAL-ONLY, GITIGNORED, NEVER ON A CLONE: the local audit workspaces
			// (audits/ — raw agent JSON, lane scripts), the mkdocs plugin cache
			// (.cache/ — vendored third-party bundles) and the developer scratch trees
			// (dev/ and dev_tools/ at any depth — probes, mock APIs, web labs, editors
			// such as client/dedalo/dev_tools/). A runner never has them, so linting
			// them made host-mode `ci:local` (and the browser budget) red on bytes no
			// CI run can see. Nothing under any is tracked (git ls-files is empty) —
			// measured, not assumed: test/unit/lint_scope_local_only_untracked_tripwire.test.ts
			// reads this group and names any tracked path under one of its patterns.
			// rewrite/ joined 2026-10-12 (AGENTS.md: internal process, gitignored, never
			// on a clone): an untracked TUI mockup under rewrite/plans/ put 11 errors
			// into host `biome check .` that no runner can see.
			"!**/audits",
			"!**/.cache",
			"!**/dev",
			"!**/dev_tools",
			"!**/rewrite",

			// HAND-AUTHORED PROSE — the manual (mkdocs sources, the style guide, the
			// docs_current_engine_tripwire gate read it), tracked and edited
			// constantly, so NOT "generated" in the sense above. It is 395 files of
			// markdown plus exactly three mkdocs THEME assets
			// (additional_javascript.js and two .css) that belong to the doc site's
			// presentation, not to the engine.
			"!**/docs",

			// FROZEN FIXTURE BYTES. These files ARE the contract — the replayed
			// oracle store and the per-component sample payloads. Reformatting one is
			// a wire-contract edit, and biome must never make it as a side effect.
			"!**/test/parity/fixtures/**/*.response.json",
			"!**/test/parity/fixtures/oracle_harvest",
			"!**/src/core/components/**/*/samples/**/*.json",
			"!**/.claude_migration_component_alias_preimage.json",

			// INSTALL SEED DATA (gzipped pg dumps + generated registries), machine
			// written and machine read.
			"!**/install/import",
			"!**/tools/**/*/register.json",

			// STATIC ASSETS with no JS/TS in them.
			"!**/tools/**/*/css",
			"!**/tools/**/*/img",

			// THE PUBLICATION DAEMONS — excluded from `biome check .`, but NOT unmeasured.
			// (Corrected 2026-10-21. This was one `!**/publication` "read-only and gated
			// separately" — false for two of the three: site_builder and host_agent WRITE
			// sites and web-server rules, and their separate gate is tsc + bun test with no
			// lint, so `biome check publication/site_builder` answered "Checked 0 files".)
			// Each package carries a SHRINK-ONLY error ceiling with the SAME rule set,
			// derived from this file: PUBLICATION_BUDGETS in
			// test/unit/lint_scope_tripwire.test.ts. A NEW directory under publication/
			// is linted by default.
			"!**/publication/site_builder",
			"!**/publication/host_agent",
			"!**/publication/server_api/v2",

			// LEGACY AND NOT OURS: the PHP v1 Publication API, whose only lintable bytes
			// are its docs page and the vendored swagger-ui bundle (3363 errors, all in
			// the third-party bundle).
			"!**/publication/server_api/v1",

			// THE BROWSER TREES — excluded from `biome check .`, but NOT unmeasured.
			// Deleting these two would turn verify red for the whole length of the
			// burn-down (1765 errors on client/ alone, measured 2026-08-31), which is
			// how a gate gets switched off. Instead they carry a SHRINK-ONLY error
			// budget with the SAME rule set, derived from this file rather than copied:
			// scripts/lint_browser_budget.ts + engineering/lint_browser_budget.json.
			"!**/client",
			"!**/tools/**/*/js",
			// GENERATED data, not source: the `test` TLD ontology export (6.5 MiB) and the
			// corpus derived from it. Biome refuses files over its 1 MiB cap anyway, and
			// formatting a machine-written export would only fight its writer.
			"!**/src/core/test_data/test_tld_ontology.json",
			"!**/src/core/test_data/test_corpus/**/*.json"
		]
	}
}
